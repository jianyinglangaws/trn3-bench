+  c1_warm     one request whose 78k prefix is cached, 1 output token: the suffix
+              prefill (~6.7k tokens) that stalls running decodes in mixed serving.
+  c1_tail     a fully cached prompt re-sent: only its last <=64 tokens prefill (the 128-bucket
+              graph of the gang's parked tails), 1 output token.
   cN_decode   N such requests at once (--batch, default 6: the most that fit
               next to the profiler's buffers), profiled once all N decode.
 
@@ -101,6 +105,22 @@ def main():
     [w] = run_requests(client, ps[-1:], salt, 1)
     w.join()
 
+    if "c1_warm" in sessions:
+        def warm():
+            [r] = run_requests(client, ps[10:11], salt, 1)
+            r.join()
+        profiled(base, "c1_warm", warm)
+
+    if "c1_tail" in sessions:
+        # the same prompt twice: the second only prefills its last (<= HY3_PREFIX_ALIGN) tokens, i.e. the
+        # 128-bucket graph the prefill gang's parked tails run (alone in the trace, so the buffer holds it)
+        [f] = run_requests(client, ps[11:12], salt, 1)
+        f.join()
+        def tail():
+            [r] = run_requests(client, ps[11:12], salt, 1)
+            r.join()
+        profiled(base, "c1_tail", tail)
+
     if "c1_decode" in sessions:
         def c1():
             [r] = run_requests(client, ps[:1], salt, 900)
diff --git a/contrib/models/hy_v3/scripts/reexport_kv_profile.py b/contrib/models/hy_v3/scripts/reexport_kv_profile.py
new file mode 100644
index 0000000..a333d3f
--- /dev/null
+++ b/contrib/models/hy_v3/scripts/reexport_kv_profile.py
@@ -0,0 +1,28 @@
+"""Re-export a Hy3 KV scale profile for another FP8 range from its stored per-layer absmax.
+
+Usage: python reexport_kv_profile.py <src.safetensors> <dst.safetensors> <target_fp8_max>
+The DEQUANT scales become absmax / target_fp8_max (same clipping point, full range).
+"""
+import json, os, sys
+from safetensors import safe_open
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
+import kv_scales as K
+
+src, dst, tmax = sys.argv[1], sys.argv[2], float(sys.argv[3])
+with safe_open(src, "pt") as f:
+    meta = dict(f.metadata())
+    n = int(meta["num_layers"])
+    old_k = [float(f.get_tensor(K.scale_key(i, "k_scale"))) for i in range(n)]
+    old_v = [float(f.get_tensor(K.scale_key(i, "v_scale"))) for i in range(n)]
+ka, va, omax = json.loads(meta["k_absmax"]), json.loads(meta["v_absmax"]), float(meta["target_fp8_max"])
+assert len(ka) == len(va) == n
+# the stored absmax must reproduce the source scales
+err = max(max(abs(a / omax - d) / d for a, d in zip(ka, old_k)), max(abs(a / omax - d) / d for a, d in zip(va, old_v)))
+print(f"{n} layers; source target {omax}; max rel diff absmax/{omax} vs stored scales {err:.2e}")
+assert err < 1e-5, "absmax metadata does not reproduce the stored scales"
+meta.update(target_fp8_max=str(tmax),
+            reexported_from=json.dumps({"file": src.split("/")[-1], "sha256": K.file_sha256(src), "target_fp8_max": omax}))
+for k in ("format", "direction", "num_layers"):
+    meta.pop(k, None)
+sha = K.save_profile(dst, [a / tmax for a in ka], [a / tmax for a in va], meta)
+print("wrote", dst, "sha256", sha)
