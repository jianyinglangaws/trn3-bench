new file mode 100755
index 0000000..caaa9ef
--- /dev/null
+++ b/contrib/models/hy_v3/scripts/serve_85k_trn3.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# One trn3 node (TP=64, EP=64), 85k shared-prefix workload under the SLO TTFT P50 < 7 s, TPOT P50 < 20 ms,
+# prefix-cache hit > 92% (bench_85k_slo.sh): prefill and decode on the same server, FP8 KV, MTP k=3,
+# sparse prefill / decode attention 0.0625, max_model_len 87040, up to 24 running requests.
+# Measured (docs/TRN3_85K_SLO.md): C = 20 ~790 output tok/s with every SLO met; C = 24 ~880 tok/s, TPOT P50 at 19.5-20.5 ms.
+#
+# Env: MODEL, PORT as for serve.sh; GANG_WAIT (default 4.5 s; 5.5 trades TTFT for TPOT at C = 24); NUM_BLOCKS (default 16000).
+# Every HY3_* flag below is documented where model.py / scheduler.py reads it; the rest of the HY3_* flags in model.py
+# are experiments that are off by default.
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+
+export KV_DTYPE=fp8 MTP_K=3
+export HY3_KV_SCALE_PROFILE=${HY3_KV_SCALE_PROFILE:-kv_profiles/Hy3-FP8_mtp_neuron_trn3.safetensors}  # 448-range (OCP FP8) scales
+export VLLM_NEURON_LIBTORCH_NEURONX_LITE=1 VLLM_NEURON_BACKEND=neuron_native
+export VLLM_NEURON_RESERVED_HEADROOM_GIB=${VLLM_NEURON_RESERVED_HEADROOM_GIB:-8}
+# Admission: the worst-case cap (no prefix sharing) would admit 5 requests at max_model_len 87040; the shared prefix
+# is stored once, so 24 fit in the pinned pool.
+export VLLM_NEURON_MAX_KV_CONCURRENT=${VLLM_NEURON_MAX_KV_CONCURRENT:-24}
+
+# Prefill: STATIC_MX routed experts (trn3 FP8 MX matmul), no in-kernel reduce, weight-reload skip, top-k all-gather,
+# padded routing rows / mapping on the NKI path, coarse 64-token blocks for segmented attention, block-granular K/V
+# cache writes, RoPE table, sparse prefill prep.
+export HY3_MOE_CTE_MX=1 HY3_MOE_CTE_NO_REDUCE=1 HY3_MOE_CTE_SKIP_WEIGHT=1 HY3_MX_DMA_SPLIT=2 HY3_PREFILL_AG_TOPK=1 \
+    HY3_MOE_ROWPAD=1 HY3_MOE_PIPE=1 HY3_PREFILL_MOE_SPLIT=1 HY3_PREFILL_FUSED_QKV=0 \
+    HY3_PREFILL_ATTN_BLOCK=64 HY3_PREFIX_ALIGN=64 HY3_PREFILL_ROW_SCATTER=1 HY3_PREFILL_BLOCK_SCATTER=1 \
+    HY3_ROPE_TABLE=1 HY3_KSUM_PREFILL_PREP=1 HY3_SPARSE_PREFILL_PREP=1
+# Decode: fused MoE (MX), KV data parallelism (forked attention_block_tkg, 8 ranks per KV head) with sparse selection
+# inside it, kernel-returned K + fused K-summary update, selection every 16 layers, flat-gather selection, constant
+# per-step tensors, pooled output / H2D buffers.
+export HY3_DECODE_MOE_FUSED=1 HY3_DECODE_MOE_MX=1 HY3_DECODE_HITS=0 \
+    HY3_DECODE_KVDP_FORK=8 HY3_DECODE_KVDP_MIN_B=2 HY3_SPARSE_KVDP=1 \
+    HY3_SPARSE_PREFILL=0.0625 HY3_SPARSE_DECODE=0.0625 HY3_SPARSE_MIN_BATCH=4 HY3_SPARSE_SELECT_EVERY=16 \
+    HY3_SPARSE_KFROM_KERNEL=1 HY3_SPARSE_KSUM_KERNEL=1 HY3_SPARSE_KSUM_SELECT_ONLY=1 HY3_SPARSE_FLAT_GATHER=1 \
+    HY3_DECODE_STEP_CONST=1 HY3_IO_STABLE=2 HY3_IO_STABLE_MAXB=0 HY3_IO_STABLE_H2D=3
+# Scheduler: gang prefill (hold the next prefills until a gang forms, release together) so decodes stall fewer times.
+export HY3_PREFILL_GANG=1 HY3_GANG_MAX_WAIT_S=${GANG_WAIT:-4.5} HY3_GANG_TAIL=64 HY3_GANG_GATHER_S=0.25 HY3_GANG_NO_TAIL=1
+
+export NUM_BLOCKS=${NUM_BLOCKS:-16000} KV_SEGMENTS='[8192]'
+export PREFILL_BUCKETS='[128, 512, 1024, 2048, 4096, 7168, 8192]'
+exec "$HERE/serve.sh" 87040 24 '[1, 8, 16, 20, 24]' '[32768]'
