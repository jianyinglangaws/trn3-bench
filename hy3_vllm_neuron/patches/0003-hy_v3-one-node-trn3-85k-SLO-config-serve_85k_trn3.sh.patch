diff --git a/contrib/models/hy_v3/scripts/bench_85k_slo.sh b/contrib/models/hy_v3/scripts/bench_85k_slo.sh
new file mode 100755
index 0000000..3d2745b
--- /dev/null
+++ b/contrib/models/hy_v3/scripts/bench_85k_slo.sh
@@ -0,0 +1,54 @@
+#!/bin/bash
+# 85k SLO benchmark against a running server (serve_85k_trn3.sh): closed loop at concurrency C, every request = the
+# shared 78,336-token prefix of bench_data/prefix + its own suffix (85,000 tokens), OUT_LEN output tokens (ignore_eos),
+# temperature 0.9. One warm-up request first fills the shared prefix for this run's cache_salt.
+# SLO: TTFT P50 < 7 s, TPOT P50 < 20 ms, prefix-cache hit rate > 92% (from the server's /metrics).
+# Prompts beyond the dataset's 80 suffixes reuse a suffix with a unique "[i] " marker after the shared prefix, so the
+# prefix cache still stops at the shared prefix.
+# Usage: bench_85k_slo.sh <result dir> "<concurrencies>" [num_prompts=10*C] [out_len=1024]
+# Env: BASE_URL (http://127.0.0.1:8000), MODEL (tokenizer path, tencent/Hy3-FP8).
+set -uo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+O=$1; CS=$2; NP=${3:-}; OUT_LEN=${4:-1024}
+BASE_URL=${BASE_URL:-http://127.0.0.1:8000}; MODEL=${MODEL:-tencent/Hy3-FP8}
+PD=$HERE/../bench_data/prefix
+mkdir -p "$O"; TMP=$(mktemp -d); trap 'rm -rf $TMP' EXIT
+counter() { curl -s "$BASE_URL/metrics" | awk -v n="$1" '$1 ~ "^"n"(_total)?([{]|$)" {s += $NF} END {printf "%d", s}'; }
+for C in $CS; do
+  N=${NP:-$((C * 10))}
+  python3 - "$PD/in85000_p78336_c8.jsonl.gz" "$TMP/p.jsonl" "$N" <<'PY'
+import gzip, json, sys
+rows = [json.loads(l) for l in gzip.open(sys.argv[1], "rt")]
+n = int(sys.argv[3])
+with open(sys.argv[2], "w") as f:
+    for i in range(n):
+        r = rows[1 + i % (len(rows) - 1)]
+        tag = "" if i < len(rows) - 1 else f"[{i}] "
+        f.write(json.dumps({"prompt": rows[0]["prefix"] + tag + r["suffix"]}, ensure_ascii=False) + "\n")
+PY
+  salt="slo-c$C-$(date +%s)"
+  common=(--backend openai-chat --base-url "$BASE_URL" --endpoint /v1/chat/completions --model "$MODEL"
+          --served-model-name hy3 --tokenizer "$MODEL" --trust-remote-code --dataset-name custom
+          --skip-chat-template --ignore-eos --extra-body "{\"cache_salt\": \"$salt\"}")
+  head -1 "$TMP/p.jsonl" > "$TMP/w.jsonl"
+  vllm bench serve "${common[@]}" --dataset-path "$TMP/w.jsonl" --custom-output-len 1 --num-prompts 1 > "$O/c$C.warm.log" 2>&1
+  q0=$(counter vllm:prefix_cache_queries); h0=$(counter vllm:prefix_cache_hits)
+  s0=$(counter vllm:spec_decode_num_drafts); a0=$(counter vllm:spec_decode_num_accepted_tokens)
+  vllm bench serve "${common[@]}" --dataset-path "$TMP/p.jsonl" --temperature 0.9 --request-rate inf \
+    --custom-output-len "$OUT_LEN" --num-prompts "$N" --max-concurrency "$C" --num-warmups 0 \
+    --percentile-metrics ttft,tpot,itl,e2el --metric-percentiles 50,90,99 \
+    --save-result --save-detailed --result-dir "$O" --result-filename "c$C.json" > "$O/c$C.log" 2>&1
+  q1=$(counter vllm:prefix_cache_queries); h1=$(counter vllm:prefix_cache_hits)
+  s1=$(counter vllm:spec_decode_num_drafts); a1=$(counter vllm:spec_decode_num_accepted_tokens)
+  python3 - "$O/c$C.json" "$C" $((q1 - q0)) $((h1 - h0)) $((s1 - s0)) $((a1 - a0)) <<'PY' | tee -a "$O/summary.txt"
+import json, sys
+p, C, q, h, s, a = sys.argv[1], *map(int, sys.argv[2:])
+r = json.load(open(p)); r.update(prefix_cache_hit_rate=h / q if q else 0, spec_steps=s, spec_accepted=a)
+json.dump(r, open(p, "w"))
+ok = r["median_ttft_ms"] < 7000 and r["median_tpot_ms"] < 20 and r["prefix_cache_hit_rate"] > 0.92
+mtp = f" MTP {1 + a / s:.2f} tok/step" if s else ""
+print(f"c={C} {r['completed']}/{r['num_prompts']} TTFT p50/p90 {r['median_ttft_ms']/1e3:.2f}/{r['p90_ttft_ms']/1e3:.2f} s "
+      f"TPOT p50/p90 {r['median_tpot_ms']:.2f}/{r['p90_tpot_ms']:.2f} ms ITL p50 {r['median_itl_ms']:.1f} "
+      f"hit {r['prefix_cache_hit_rate']:.1%} out {r['output_throughput']:.0f} tok/s{mtp}  SLO {'PASS' if ok else 'fail'}")
+PY
+done
