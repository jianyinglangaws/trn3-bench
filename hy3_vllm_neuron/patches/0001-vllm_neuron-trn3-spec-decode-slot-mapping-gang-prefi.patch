diff --git a/vllm_neuron/vllm/worker/neuron_profiler.py b/vllm_neuron/vllm/worker/neuron_profiler.py
index f4a0ff6..f3fb027 100644
--- a/vllm_neuron/vllm/worker/neuron_profiler.py
+++ b/vllm_neuron/vllm/worker/neuron_profiler.py
@@ -39,6 +39,12 @@ class NeuronProfilerConfig:
     """Parsed neuron_profiler configuration from --additional-config."""
 
     def __init__(self, config_dict: dict[str, Any] | None = None) -> None:
+        # The options may also come from $VLLM_NEURON_PROFILER_JSON. additional_config is part of vLLM's
+        # compile hash, so passing them there makes a profiling server recompile every graph.
+        if not config_dict and os.environ.get("VLLM_NEURON_PROFILER_JSON"):
+            import json
+
+            config_dict = json.loads(os.environ["VLLM_NEURON_PROFILER_JSON"])
         config_dict = config_dict or {}
         self.activities: list[str] = config_dict.get("activities", _DEFAULT_ACTIVITIES)
         self.neuron_cores: list[int] | None = config_dict.get("neuron_cores", None)
diff --git a/vllm_neuron/vllm/worker/neuron_worker.py b/vllm_neuron/vllm/worker/neuron_worker.py
index a17cb4a..5ff88e5 100644
--- a/vllm_neuron/vllm/worker/neuron_worker.py
+++ b/vllm_neuron/vllm/worker/neuron_worker.py
@@ -910,7 +910,7 @@ class NeuronWorker(WorkerBase):
             # latency win while the TPOT/HBM curves have both flattened, so
             # going higher only costs HBM for no gain. Override via env.
             # See P453665601.
-            os.environ.setdefault("NEURON_RT_IO_RING_CACHE_SIZE", "32")
+            os.environ.setdefault("NEURON_RT_IO_RING_CACHE_SIZE", os.environ.get("HY3_IO_RING_CACHE", "32"))
 
             # Disable the per-exec execution barrier: the cross-rank rendezvous
             # wait (enc_barrier) is the other major component of async-decode
-- 
2.53.0

