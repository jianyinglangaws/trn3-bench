index 2c9b5b3..9d5fa03 100644
--- a/vllm_neuron/functional/spec_decode_correction.py
+++ b/vllm_neuron/functional/spec_decode_correction.py
@@ -176,9 +176,11 @@ def _compute_slot_mapping_per_token(
         block_ids = block_table_tensor.view(-1)[flat_idx]
         return dcp_local_slot_mapping(positions, block_ids, block_size, dcp_size, dcp_rank)
     block_numbers = positions.to(torch.int64) // block_size  # [total_scheduled]
-    max_blocks = block_table_tensor.shape[1]
-    flat_idx = req_indices_per_token * max_blocks + block_numbers
-    block_ids = block_table_tensor.view(-1)[flat_idx]  # [total_scheduled]
+    # Row select + gather instead of a flat index (req_idx * max_blocks + n):
+    # that multiply hits neuronx-cc [NCC_ILSM901] "LegalizeSundaMacro: Cannot
+    # split" on trn3 (every decode graph of a spec-enabled server runs this).
+    rows = block_table_tensor.index_select(0, req_indices_per_token)  # [T, max_blocks]
+    block_ids = rows.gather(1, block_numbers.view(-1, 1)).view(-1)  # [total_scheduled]
     slot = block_ids.to(torch.int64) * block_size + (
         positions.to(torch.int64) % block_size
     )
