+    # remainder and Core 1 short-circuits.
+    #
+    # Prior-segment chunking reuses the top-level prior_seg_size on both cores so
+    # num_full_prior_segments_i32 is identical across cores; this keeps the 3
+    # nl.dynamic_range loops inside fused_segmented_attention_impl iterating the
+    # same number of times (LNC2 sync requirement).
+    # Hy3 fork: core 0 takes ~66% of the query groups instead of half. Core 1 also attends
+    # over core 0's active rows (the extra iteration below), so with a 50/50 split the
+    # causal work is 1:3 at prior 0; c0 ~ 0.71 N balances prior 0, ~0.58 N balances prior N.
+    core0_grp_length = min(num_grps - 1, max((num_grps + 1) // 2, int(round(num_grps * _CORE0_FRAC))))
+    if num_grps <= 1:
+        core0_grp_length = num_grps
+    core1_grp_length = num_grps - core0_grp_length
+    if shard_id == 0:
+        grp_length = core0_grp_length
+        grp_start = 0
+    else:
+        grp_length = core1_grp_length
+        grp_start = core0_grp_length
+
