+
+"""Fused decode MoE: the routed hits (moe_tkg_hits_batch) plus the decode shared-expert slice.
+
+HY3_DECODE_FUSED_SHARED. Today the decode shared expert (an 8-way slice, I = 192 padded to 256)
+is its own kernel: it RMS-normalizes the raw hidden state again, loads it, runs a tiny MLP and
+transposes / stores its output, which is then added in XLA. Here the shared slice runs as one
+more static pass of the same expert body on the routed kernel's already-loaded (normalized)
+input, scaled by a constant column (the shared output weight) and accumulated into the same
+output tile, so one input load and one output store serve both. BF16 activations x FP8 weights
+for both parts, as each kernel does on its own at decode token counts.
+"""
+
+
+from typing import Optional
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+
+from nkilib.core.moe.moe_tkg.mlp_parameters import (
+    MLPBiasParameters,
+    MLPExpertParameters,
+    MLPParameters,
+    MLPQuantizationParameters,
+)
+from nkilib.core.moe.moe_tkg.mlp_tkg_constants import MLPTKGConstants
+from nkilib.core.moe.moe_tkg.mlp_tkg_down_projection import process_down_projection
+from nkilib.core.moe.moe_tkg.mlp_tkg_gate_up_projection import process_gate_up_projection
+from nkilib.core.moe.moe_tkg.moe_tkg_utils import broadcast_all_expert_affinity
+from nkilib.core.moe.moe_tkg.projection_utils import input_norm_load, transpose_store
+from nkilib.core.utils.allocator import SbufManager
+from nkilib.core.utils.common_types import (
+    ActFnType,
+    ExpertAffinityScaleMode,
+    GateUpDim,
+    NormType,
+    QuantizationType,
+)
+from nkilib.core.utils.kernel_helpers import div_ceil
+from nkilib.core.utils.logging import get_logger
+from nkilib.core.utils.stream_shuffle_broadcast import stream_shuffle_broadcast
+
+from .moe_tkg_common import quantization_type, select_quant_scales
+
+
+
+
+@nki.jit
+def moe_tkg_hits_shared(
+    hidden_input: nl.NkiTensor,
+    expert_gate_up_weights: nl.NkiTensor,
+    expert_down_weights: nl.NkiTensor,
+    expert_affinities: nl.NkiTensor,
+    expert_index: nl.NkiTensor,
+    num_hits: nl.NkiTensor,
+    shared_gate_up_weights: nl.NkiTensor,
+    shared_down_weights: nl.NkiTensor,
+    shared_affinity: nl.NkiTensor,
+    shared_index: nl.NkiTensor,
+    expert_gate_up_weights_scale: Optional[nl.NkiTensor] = None,
+    expert_down_weights_scale: Optional[nl.NkiTensor] = None,
+    shared_gate_up_weights_scale: Optional[nl.NkiTensor] = None,
+    shared_down_weights_scale: Optional[nl.NkiTensor] = None,
+    expert_gate_up_input_scale: Optional[nl.NkiTensor] = None,
+    expert_down_input_scale: Optional[nl.NkiTensor] = None,
+    shared_gate_up_input_scale: Optional[nl.NkiTensor] = None,
+    shared_down_input_scale: Optional[nl.NkiTensor] = None,
+    activation_fn: ActFnType = ActFnType.SiLU,
+):
+    """Routed hits as moe_tkg_hits_batch, plus ``shared_affinity * shared(hidden)``.
+
+    Args (beyond moe_tkg_hits_batch):
+        shared_gate_up_weights: [1, H, 2, I_s] FP8, shared_down_weights: [1, I_s, H] FP8.
+        shared_affinity: [T, 1] fp32, the shared output weight per token (a constant).
+        shared_index: [1, 1] int32 zeros.
+        shared_*_scale: [1, 2, 1] / [1, 1] static weight scales (like the routed tkg scales).
+    """
+    def _params(gu, dn, aff, idx, gus, dns, guis, dnis):
+        quant_type = quantization_type(
+            expert_gate_up_weights=gu,
+            expert_gate_up_weights_scale=gus,
+            expert_down_weights_scale=dns,
+            expert_gate_up_input_scale=guis,
+            expert_down_input_scale=dnis,
+        )
+        return MLPParameters(
+            hidden_tensor=hidden_input,
+            gate_proj_weights_tensor=gu,
+            up_proj_weights_tensor=gu,
+            down_proj_weights_tensor=dn,
+            activation_fn=activation_fn,
+            normalization_type=NormType.NO_NORM,
+            gate_w_scale=gus,
+            up_w_scale=gus,
+            down_w_scale=dns,
+            gate_up_in_scale=guis,
+            down_in_scale=dnis,
+            output_dtype=hidden_input.dtype,
+            use_tkg_gate_up_proj_column_tiling=False,
+            use_tkg_down_proj_column_tiling=False,
+            shard_on_h_disabled=False,
+            expert_params=MLPExpertParameters(
+                expert_affinities=aff,
+                expert_index=idx,
+                expert_affinities_eager=None,
+                expert_affinities_scaling_mode=ExpertAffinityScaleMode.POST_SCALE,
+            ),
+            quantization_type=quant_type,
+        )
+
+    assert hidden_input.shape[0] <= 128, "moe_tkg_hits_shared: at most 128 tokens"
+    assert num_hits.dtype == nl.int32 and expert_index.dtype == nl.int32 and shared_index.dtype == nl.int32
+    assert expert_affinities.dtype == nl.float32 and shared_affinity.dtype == nl.float32
+    params = _params(expert_gate_up_weights, expert_down_weights, expert_affinities, expert_index,
+                     expert_gate_up_weights_scale, expert_down_weights_scale,
+                     expert_gate_up_input_scale, expert_down_input_scale)
+    params_s = _params(shared_gate_up_weights, shared_down_weights, shared_affinity, shared_index,
+                       shared_gate_up_weights_scale, shared_down_weights_scale,
+                       shared_gate_up_input_scale, shared_down_input_scale)
+    output = nl.ndarray(hidden_input.shape, dtype=hidden_input.dtype, buffer=nl.shared_hbm)
+    _hits_and_shared(params, params_s, num_hits, output)
+    return output
+
+
+def _expert_pass(params, dims, initial, slot_idx, aff_sb, E, T, bufs, output_temp, identity_sb, sbm, io_dtype):
+    """One expert: slot 0 of ``slot_idx`` weights, scaled per token by column 0 of ``aff_sb``."""
+    initial_gate, initial_up, initial_down, initial_quant = initial
+    gate_up_output, gate_up_fp32, down_sb, hidden_sb = bufs
+    allocator = sbm.alloc_stack
+    slot0 = slot_idx.ap(pattern=[[E, 1], [1, 1]], offset=0)
+    params.gate_proj_weights_tensor = initial_gate.select(dim=0, index=slot0).select(dim=1, index=GateUpDim.GATE.value)
+    params.up_proj_weights_tensor = initial_up.select(dim=0, index=slot0).select(dim=1, index=GateUpDim.UP.value)
+    params.down_proj_weights_tensor = initial_down.select(dim=0, index=slot0)
+    params.quant_params = select_quant_scales(initial_quant, slot0)
+    if initial_quant.quantization_type == QuantizationType.STATIC:
+        gate_w_dq = nl.ndarray((nl.tile_size.pmax, 1), dtype=nl.float32, buffer=nl.sbuf)
+        up_w_dq = nl.ndarray((nl.tile_size.pmax, 1), dtype=nl.float32, buffer=nl.sbuf)
+        down_w_dq = nl.ndarray((nl.tile_size.pmax, 1), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.dma_copy(dst=gate_w_dq[0:1, 0:1], src=params.quant_params.gate_w_scale.slice(dim=0, start=0, end=1))
+        stream_shuffle_broadcast(gate_w_dq, gate_w_dq)
+        nisa.dma_copy(dst=up_w_dq[0:1, 0:1], src=params.quant_params.up_w_scale.slice(dim=0, start=0, end=1))
+        stream_shuffle_broadcast(up_w_dq, up_w_dq)
+        nisa.dma_copy(dst=down_w_dq[0:1, 0:1], src=params.quant_params.down_w_scale.slice(dim=0, start=0, end=1))
+        stream_shuffle_broadcast(down_w_dq, down_w_dq)
+        params.quant_params = MLPQuantizationParameters(
+            quantization_type=QuantizationType.STATIC,
+            gate_w_scale=gate_w_dq,
+            up_w_scale=up_w_dq,
+            down_w_scale=down_w_dq,
+            gate_up_in_scale=None,
+            down_in_scale=None,
+            clipping_bound=params.quant_params.clipping_bound,
+        )
+    gate_tile_info = process_gate_up_projection(
+        hidden=hidden_sb, output=gate_up_output, params=params, dims=dims, sbm=sbm,
+        share_memory_scope=True, use_dge=True, prealloc_gate_up_buffers=gate_up_fp32,
+    )
+    process_down_projection(
+        hidden=gate_up_output, output=down_sb, params=params, dims=dims,
+        gate_tile_info=gate_tile_info, sbm=sbm, use_dge=True,
+    )
+    aff_b = broadcast_all_expert_affinity(aff_sb, 1, 0, 0, T, io_dtype, identity_sb, dims, allocator, sbm.use_auto_alloc)
+    for shard in range(dims.H1_shard):
+        nisa.tensor_tensor(data1=down_sb[: dims.H0, shard, :T], data2=aff_b, op=nl.multiply, dst=down_sb[: dims.H0, shard, :T])
+    nisa.tensor_tensor(
+        data1=down_sb[: dims.H0, : dims.H1_shard, :T],
+        data2=output_temp[: dims.H0, : dims.H1_shard, :T],
+        op=nl.add,
+        dst=output_temp[: dims.H0, : dims.H1_shard, :T],
+    )
+
+
+def _hits_and_shared(params, params_s, num_hits, output):
+    T, H = params.hidden_tensor.shape
+    sbm = SbufManager(0, 200 * 1024, get_logger("hits_shared"), use_auto_alloc=H >= 16 * 1024)
+    sbm.open_scope()
+    allocator = sbm.alloc_stack
+    io_dtype = params.hidden_tensor.dtype
+    dims = MLPTKGConstants.calculate_constants(params)
+    dims_s = MLPTKGConstants.calculate_constants(params_s)
+    assert dims.H0 == dims_s.H0 and dims.H1_shard == dims_s.H1_shard, "shared/routed H tiling must match"
+    E = dims.E
+
+    input_sb = allocator([dims.H0, T, dims.H1_shard], dtype=io_dtype, buffer=nl.sbuf, name="input_sb")
+    input_norm_load(params.hidden_tensor, input_sb, params, dims, sbm=sbm)
+    output_temp = allocator((dims.H0, dims.H1_shard, T), dtype=io_dtype, buffer=nl.sbuf, name="out_acc")
+    nisa.memset(output_temp, value=0.0)
+    identity_sb = nl.shared_identity_matrix(T, dtype=io_dtype)
+
+    def _bufs(d, tag):
+        n_i = div_ceil(d.I, d.I0)
+        gu = allocator((d.I0, n_i, T), dtype=io_dtype, buffer=nl.sbuf, name=f"gate_up_sb_{tag}")
+        dn = allocator((d.H0, d.H1_shard, T), dtype=io_dtype, buffer=nl.sbuf, name=f"down_sb_{tag}")
+        fp = tuple(nl.ndarray((d.I0, n_i, T), dtype=nl.float32, buffer=nl.sbuf) for _ in range(2))
+        return gu, fp, dn, input_sb
+
+    bufs = _bufs(dims, "r")
+    bufs_s = _bufs(dims_s, "s")
+
+    # routed: hit list + affinity columns, shifted left by one per iteration
+    expert_idx = allocator((1, E), dtype=nl.int32, buffer=nl.sbuf, name="hit_idx")
+    nisa.dma_copy(dst=expert_idx, src=params.expert_params.expert_index[0:1, 0:E])
+    idx_shift = allocator((1, E), dtype=nl.int32, buffer=nl.sbuf, name="hit_idx_shift")
+    aff_sb = allocator((T, E), dtype=nl.float32, buffer=nl.sbuf, name="aff_sb")
+    nisa.dma_copy(dst=aff_sb[:T, :E], src=params.expert_params.expert_affinities[:T, :E])
+    aff_shift = allocator((T, E), dtype=nl.float32, buffer=nl.sbuf, name="aff_shift")
+    n_sb = allocator((1, 1), dtype=nl.int32, buffer=nl.sbuf, name="num_hits_sb")
+    nisa.dma_copy(dst=n_sb, src=num_hits[0:1, 0:1])
+    n_reg = nisa.register_alloc()
+    nisa.register_load(src=n_sb, dst=n_reg)
+    initial = (params.gate_proj_weights_tensor, params.up_proj_weights_tensor, params.down_proj_weights_tensor, params.quant_params)
+    params.bias_params = MLPBiasParameters(None, None, None)
+    dims.T = T
+
+    def _body(_):
+        sbm.open_scope()
+        _expert_pass(params, dims, initial, expert_idx, aff_sb, E, T, bufs, output_temp, identity_sb, sbm, io_dtype)
+        nisa.tensor_copy(dst=idx_shift[0:1, 0 : E - 1], src=expert_idx[0:1, 1:E])
+        nisa.tensor_copy(dst=expert_idx[0:1, 0 : E - 1], src=idx_shift[0:1, 0 : E - 1])
+        nisa.tensor_copy(dst=aff_shift[:T, 0 : E - 1], src=aff_sb[:T, 1:E])
+        nisa.tensor_copy(dst=aff_sb[:T, 0 : E - 1], src=aff_shift[:T, 0 : E - 1])
+        sbm.close_scope()
+
+    nl.fori_loop(0, n_reg, _body)
+
+    # shared slice: one static pass, constant affinity column
+    s_idx = allocator((1, 1), dtype=nl.int32, buffer=nl.sbuf, name="shared_idx")
+    nisa.dma_copy(dst=s_idx, src=params_s.expert_params.expert_index[0:1, 0:1])
+    s_aff = allocator((T, 1), dtype=nl.float32, buffer=nl.sbuf, name="shared_aff")
+    nisa.dma_copy(dst=s_aff[:T, :1], src=params_s.expert_params.expert_affinities[:T, :1])
+    initial_s = (params_s.gate_proj_weights_tensor, params_s.up_proj_weights_tensor, params_s.down_proj_weights_tensor, params_s.quant_params)
+    params_s.bias_params = MLPBiasParameters(None, None, None)
+    dims_s.T = T
+    # nkilib allocates its per-expert buffers under fixed names; the second expert body needs its own prefix
+    prev_prefix = sbm.get_name_prefix()
+    sbm.set_name_prefix(prev_prefix + "shared_")
+    sbm.open_scope()
+    _expert_pass(params_s, dims_s, initial_s, s_idx, s_aff, 1, T, bufs_s, output_temp, identity_sb, sbm, io_dtype)
+    sbm.close_scope()
+    sbm.set_name_prefix(prev_prefix)
+
+    dims.T = T
+    transpose_store(output_temp, output, dims, params.output_dtype, sbm, 0)
+    sbm.close_scope()
+    return output
