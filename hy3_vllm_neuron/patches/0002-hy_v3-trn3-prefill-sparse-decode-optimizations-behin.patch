+        xq = fq(x, ckpt.scalar(f"{q}.gate_proj.input_scale"))
+        h = torch.nn.functional.silu(xq @ w["gate"].T) * (xq @ w["up"].T)
+        y = fq(h, ckpt.scalar(f"{q}.down_proj.input_scale")) @ w["down"].T
+        out += y * aff[:, e : e + 1]
+    return out
