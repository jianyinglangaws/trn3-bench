@@ -0,0 +1,344 @@
+# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License").
+# You may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+# Derived from vllm_neuron.functional.attention.attention_decode (vllm-neuron 0.29).
+
+"""Decode attention block with KV data parallelism over the replicated KV head.
+
+At TP=64 Hy3 has one Q head per rank and its 8 KV heads replicated on groups of
+8 consecutive ranks. ``NF.attention_decode`` makes every rank read the whole
+KV of every sequence for its single Q head, so each KV byte is read 8 times
+per KV group. With ``KVDP = g`` (g ranks of one KV group) the kernel
+(``attention_block_tkg`` KVDP mode) computes QKV for all B sequences as usual,
+exchanges Q inside the group so each rank holds all g Q heads of B/g
+sequences, runs attention on its B/g sequences (1/g of the KV bytes), and
+exchanges the outputs back, so the O-projection and the all-reduce are
+unchanged.
+
+The Hy3 KV cache stays replicated (prefill writes every token on every rank,
+and vLLM may move a request to another batch slot, i.e. another KVDP shard,
+between steps), so the forked kernel writes the new K/V of ALL B sequences on
+every rank (``kvdp_full_cache_update``) instead of only its B/g slice.
+
+Block KV cache, non-DCP, kv_heads=1 per rank. Caller passes the full-batch
+inputs; this module slices the block table / mask for the rank's shard.
+"""
+
+import nki
+import torch
+from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+from nki.collectives import ReplicaGroup
+from nkilib.core.utils.common_types import QuantizationType
+from nkilib.experimental.transformer.attention_block_tkg_sharding import (
+    CPCollectiveMode,
+    KVDPCollectiveMode,
+)
+from vllm_neuron.functional.attention.attention_decode_mask import (
+    gen_attention_decode_mask,
+    maybe_transpose_mask_for_qk_swap,
+)
+from vllm_neuron.utils.hardware_config import get_logical_nc_config
+
+from .attention_block_tkg_kvdp import attention_block_tkg as _attention_block_tkg_kvdp
+
+
+@nki.jit
+def _attention_block_tkg_kvdp_kernel(
+    X,
+    X_hidden_dim_actual: int = None,
+    rmsnorm_X_enabled: bool = False,
+    rmsnorm_X_eps: float = None,
+    rmsnorm_X_gamma=None,
+    W_qkv=None,
+    quantization_type_qkv: QuantizationType = QuantizationType.NONE,
+    weight_dequant_scale_qkv=None,
+    input_dequant_scale_qkv=None,
+    rmsnorm_QK_pre_rope_enabled: bool = False,
+    rmsnorm_QK_pre_rope_eps: float = 1e-6,
+    rmsnorm_QK_pre_rope_W_Q=None,
+    rmsnorm_QK_pre_rope_W_K=None,
+    cos=None,
+    sin=None,
+    rope_contiguous_layout: bool = True,
+    active_blocks_table=None,
+    K_cache=None,
+    V_cache=None,
+    attention_mask=None,
+    softmax_scale: float = None,
+    kv_cache_update_idx=None,
+    k_scale=None,
+    v_scale=None,
+    fp8_packed: bool = False,
+    W_out=None,
+    quantization_type_out: QuantizationType = QuantizationType.NONE,
+    weight_dequant_scale_out=None,
+    input_dequant_scale_out=None,
+    KVDP: int = 1,
+    KVDP_rank=None,
+    kvdp_groups: tuple = (),
+    all_to_all: bool = True,
+    CP: int = 1,
+    cp_groups: tuple = (),
+    return_k_new: bool = False,
+):
+    # ReplicaGroup takes the static tuple-of-tuples directly (the NKI frontend
+    # rejects comprehensions inside @nki.jit).
+    rg = None
+    mode = None
+    if KVDP > 1:
+        rg = ReplicaGroup(kvdp_groups)
+        mode = KVDPCollectiveMode.ALL_TO_ALL if all_to_all else KVDPCollectiveMode.ALL_GATHER_SLICE
+    # Context split (CP over the REPLICATED cache): each rank of a KV group attends
+    # its block-strided 1/CP of every sequence's context for the group's CP Q heads.
+    cp_rg = None
+    cp_mode = None
+    if CP > 1:
+        cp_rg = ReplicaGroup(cp_groups)
+        cp_mode = CPCollectiveMode.ALL_TO_ALL
+    return _attention_block_tkg_kvdp(
+        X=X,
+        X_hidden_dim_actual=X_hidden_dim_actual,
+        rmsnorm_X_enabled=rmsnorm_X_enabled,
+        rmsnorm_X_eps=rmsnorm_X_eps,
+        rmsnorm_X_gamma=rmsnorm_X_gamma,
+        W_qkv=W_qkv,
+        bias_qkv=None,
+        quantization_type_qkv=quantization_type_qkv,
+        weight_dequant_scale_qkv=weight_dequant_scale_qkv,
+        input_dequant_scale_qkv=input_dequant_scale_qkv,
+        rmsnorm_QK_pre_rope_enabled=rmsnorm_QK_pre_rope_enabled,
+        rmsnorm_QK_pre_rope_eps=rmsnorm_QK_pre_rope_eps,
+        rmsnorm_QK_pre_rope_W_Q=rmsnorm_QK_pre_rope_W_Q,
+        rmsnorm_QK_pre_rope_W_K=rmsnorm_QK_pre_rope_W_K,
+        cos=cos,
+        sin=sin,
+        rope_contiguous_layout=rope_contiguous_layout,
+        rmsnorm_QK_post_rope_enabled=False,
+        rmsnorm_QK_post_rope_eps=1e-6,
+        rmsnorm_QK_post_rope_W_Q=None,
+        rmsnorm_QK_post_rope_W_K=None,
+        K_cache_transposed=False,
+        active_blocks_table=active_blocks_table,
+        K_cache=K_cache,
+        V_cache=V_cache,
+        attention_mask=attention_mask,
+        sink=None,
+        softmax_scale=softmax_scale,
+        update_cache=True,
+        kv_cache_update_idx=kv_cache_update_idx,
+        k_scale=k_scale,
+        v_scale=v_scale,
+        fp8_packed=fp8_packed,
+        W_out=W_out,
+        bias_out=None,
+        quantization_type_out=quantization_type_out,
+        weight_dequant_scale_out=weight_dequant_scale_out,
+        input_dequant_scale_out=input_dequant_scale_out,
+        transposed_out=False,
+        out_in_sb=False,
+        sbm=None,
+        skip_attention=False,
+        is_h_transposed_by_4=False,
+        KVDP=KVDP,
+        KVDP_replica_group=rg,
+        KVDP_collective_mode=mode,
+        KVDP_rank=KVDP_rank,
+        CP=CP,
+        CP_replica_group=cp_rg,
+        CP_collective_mode=cp_mode,
+        pos_ids=None,
+        swa_start_pos_ids=None,
+        S_ctx=None,
+        kvdp_full_cache_update=KVDP > 1,
+        return_k_new=return_k_new,
+    )
+
+
+def kvdp_groups(world_size: int, kvdp: int) -> tuple:
+    """Consecutive-rank KVDP groups ``((0..kvdp-1), (kvdp..2*kvdp-1), ...)``."""
+    return tuple(
+        tuple(range(g * kvdp, (g + 1) * kvdp)) for g in range(world_size // kvdp)
+    )
+
+
+def kvdp_decode_mask(
+    positions: torch.Tensor,
+    kvdp_rank: torch.Tensor,
+    B: int,
+    S_tkg: int,
+    kvdp: int,
+    q_heads_attn: int,
+    S_ctx: int,
+    block_size: int,
+    d_head: int,
+    fp8_kv: bool,
+    fp8_packed: bool,
+) -> torch.Tensor:
+    """Pre-generated decode mask ``[S_ctx, B/kvdp, q_heads_attn, S_tkg]`` for this
+    rank's shard (same builder and QK-swap layout rule as ``NF.attention_decode``)."""
+    B_attn = B // kvdp
+    pos = positions.view(kvdp, B_attn * S_tkg).index_select(
+        0, kvdp_rank.to(torch.long).reshape(1)
+    )
+    mask = gen_attention_decode_mask(
+        pos_ids=pos.reshape(1, B_attn * S_tkg).to(torch.float32),
+        bs=B_attn,
+        q_head=q_heads_attn,
+        s_active=S_tkg,
+        s_prior=S_ctx,
+        start_pos=None,
+        block_len=block_size,
+    )
+    return maybe_transpose_mask_for_qk_swap(
+        mask, d_head=d_head, is_fp8_kv=fp8_kv, fp8_packed=fp8_packed
+    )
+
+
+def attention_decode_kvdp(
+    X: torch.Tensor,
+    block_table: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    attention_mask: torch.Tensor,
+    kvdp: int,
+    kvdp_rank: torch.Tensor,
+    world_size: int,
+    all_to_all: bool = True,
+    **kwargs,
+) -> torch.Tensor:
+    """Hy3 decode attention block (update_cache=True) with KVDP = ``kvdp``.
+
+    ``X`` [B, S_tkg, H], ``block_table`` [B, n_blocks] and ``slot_mapping``
+    [B * S_tkg] are the full batch; ``attention_mask`` comes from
+    :func:`kvdp_decode_mask`; ``kvdp_rank`` is this rank's position in its KVDP
+    group as a runtime tensor. Remaining keyword arguments are the
+    ``attention_block_tkg`` arguments Hy3 passes to ``NF.attention_decode``.
+    Returns the attention-block output ``[B * S_tkg, H]`` (O-projection
+    partial for this rank's Q head, all B sequences).
+    """
+    B, S_tkg, _ = X.shape
+    assert B % kvdp == 0, f"B={B} must be divisible by KVDP={kvdp}"
+    B_attn = B // kvdp
+    rank_l = kvdp_rank.to(torch.long).reshape(1)
+    bt = block_table.view(kvdp, B_attn, block_table.shape[-1]).index_select(0, rank_l)
+    bt = bt.reshape(B_attn, block_table.shape[-1])
+    out = wrap_nki(_attention_block_tkg_kvdp_kernel)[get_logical_nc_config()](
+        X,
+        active_blocks_table=bt,
+        attention_mask=attention_mask,
+        kv_cache_update_idx=slot_mapping.view(B, S_tkg).to(torch.uint32),
+        KVDP=kvdp,
+        KVDP_rank=kvdp_rank.to(torch.int32).reshape(1).to(torch.uint32),
+        kvdp_groups=kvdp_groups(world_size, kvdp),
+        all_to_all=all_to_all,
+        **kwargs,
+    )
+    # The kernel returns (output, K, V[, K_new]); K/V are the in-place-updated caches,
+    # K_new [d_head, B * S_tkg] the step's post-RoPE (FP8 when FP8 KV) K for all B (return_k_new).
+    if kwargs.get("return_k_new"):
+        return out[0], out[3]
+    return out[0]
+
+
+def ctxsplit_decode_mask(
+    positions: torch.Tensor,
+    cp_rank: torch.Tensor,
+    B: int,
+    S_tkg: int,
+    cp: int,
+    q_heads_attn: int,
+    S_ctx: int,
+    block_size: int,
+    d_head: int,
+    fp8_kv: bool,
+    fp8_packed: bool,
+) -> torch.Tensor:
+    """Decode mask ``[S_ctx/cp, B, q_heads_attn, S_tkg]`` for context split.
+
+    Rank ``R`` of a KV group reads blocks ``R, R+cp, R+2cp, ...`` of every
+    sequence (see :func:`attention_decode_ctxsplit`), i.e. DCP's block-cyclic
+    ownership with interleave = block_size, so DCP's formulas apply: the local
+    prior holds ``local_filled`` valid slots, and only the owner of the first
+    active position counts the S_tkg active tokens (they are not double counted
+    in the softmax combine).
+    """
+    W = cp
+    R = cp_rank.to(torch.float32).reshape(1, 1)
+    n = positions.view(B, S_tkg)[:, 0:1].to(torch.float32)
+    vblock = block_size * W
+    full_vblocks = torch.div(n, vblock, rounding_mode="trunc")
+    remaining = n - full_vblocks * vblock
+    local_filled = full_vblocks * block_size + torch.clamp(
+        remaining - R * block_size, min=0, max=block_size
+    )
+    owner = torch.remainder(torch.div(remaining, block_size, rounding_mode="trunc"), W)
+    active = (owner == R).to(torch.float32)
+    mask = gen_attention_decode_mask(
+        pos_ids=positions.view(1, B * S_tkg).to(torch.float32),
+        bs=B,
+        q_head=q_heads_attn,
+        s_active=S_tkg,
+        s_prior=S_ctx // cp,
+        start_pos=None,
+        block_len=block_size,
+        local_filled_slots=local_filled,
+        dcp_active_mask=active,
+    )
+    return maybe_transpose_mask_for_qk_swap(
+        mask, d_head=d_head, is_fp8_kv=fp8_kv, fp8_packed=fp8_packed
+    )
+
+
+def attention_decode_ctxsplit(
+    X: torch.Tensor,
+    block_table: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    attention_mask: torch.Tensor,
+    cp: int,
+    cp_rank: torch.Tensor,
+    world_size: int,
+    **kwargs,
+) -> torch.Tensor:
+    """Hy3 decode attention block with the context split ``cp`` ways over the
+    replicated KV cache (``attention_block_tkg`` CP mode, KVDP=1).
+
+    Every rank of a KV group holds the whole cache; rank ``R`` reads blocks
+    ``R::cp`` of every sequence (``block_table`` [B, n_blocks] is the full table,
+    ``n_blocks % cp == 0``), attends the group's ``cp`` Q heads over them, and
+    the in-kernel softmax combine returns each rank its own head. The cache
+    update uses the full absolute ``slot_mapping`` on every rank, so the cache
+    stays replicated. ``attention_mask`` comes from :func:`ctxsplit_decode_mask`.
+    Returns the attention-block output ``[B * S_tkg, H]``.
+    """
+    B, S_tkg, _ = X.shape
+    nb = block_table.shape[-1]
+    assert nb % cp == 0, f"blocks per sequence {nb} must be divisible by cp={cp}"
+    idx = (
+        torch.arange(nb // cp, dtype=torch.int32, device=block_table.device) * cp
+        + cp_rank.to(torch.int32).reshape(1)
+    )
+    bt = block_table.index_select(1, idx.to(torch.long))
+    out = wrap_nki(_attention_block_tkg_kvdp_kernel)[get_logical_nc_config()](
+        X,
+        active_blocks_table=bt,
+        attention_mask=attention_mask,
+        kv_cache_update_idx=slot_mapping.view(B, S_tkg).to(torch.uint32),
+        KVDP=1,
+        KVDP_rank=None,
+        kvdp_groups=(),
+        all_to_all=True,
+        CP=cp,
+        cp_groups=kvdp_groups(world_size, cp),
+        **kwargs,
+    )
+    return out[0]
