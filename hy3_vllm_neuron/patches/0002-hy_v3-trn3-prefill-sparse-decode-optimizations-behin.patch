+    ref = _experts_reference(ckpt, layer, normed, aff) + w_s * _mlp_reference(ckpt, src, shard, x_raw, ln_w, quant=False)
+    e_fs, e_f, e_s = rel_err(out_f, out_s), rel_err(out_f, ref), rel_err(out_s, ref)
