+            kernel_assert(
+                K_cache.shape == (B, d_head, S_max_ctx),
+                f"K_cache shape mismatch: expected {(B, d_head, S_max_ctx)}, got {K_cache.shape}",
+            )
+            # K_tkg is already in correct layout [d_head, B*S_tkg]
