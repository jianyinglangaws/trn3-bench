+            output_sb=output_sb[i_tile_S],
+            qkv_MM_output_psum=qkv_MM_output_psum,
+            s_tile_sz=s_tile_sz,
+            i_tile_S=i_tile_S,
+            bias_sb=bias_sb,
+            row_mx_input_scale=row_mx_input_scale,
+            I=I,
+            num_512_tiles_per_I=dims.num_512_tiles_per_I,
