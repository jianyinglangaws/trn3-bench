+def _evict_psum_to_sbuf(
+    qkv_MM_output_psum: list,
+    output_sb: List[nl.NkiTensor],
+    i_tile_S: int,
+    s_tile_sz: int,
+    cfg: QKV_CTE_Config,
+    dims: QKV_CTE_Dims,
+    bias_sb: Optional[nl.NkiTensor],
+    I: int,
+    use_static_dequant: bool,
+    mx_dequant_sb: Optional[nl.NkiTensor],
