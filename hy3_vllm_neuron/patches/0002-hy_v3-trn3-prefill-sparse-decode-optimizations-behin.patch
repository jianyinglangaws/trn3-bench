+                        offset=batch_idx * d_head * S_max_ctx,
+                        scalar_offset=start_position,
+                        indirect_dim=2,
+                    ),
+                    src=K_tkg[:, nl.ds(batch_idx * S_tkg, S_tkg)],
+                    oob_mode=dma_oob_mode,
