+@pytest.mark.parametrize("tokens", [4, 8, 16])
+def test_routed_experts_hits_shared(ckpt, single_rank_tp, tokens):
+    """HY3_DECODE_FUSED_SHARED: routed hits + the 8-way decode shared slice in one kernel ==
+    moe_tkg_hits_batch + the shared slice's own kernel (and both vs FP32 references)."""
+    from hy_v3_neuron.weight_loaders import (
+        shared_down_hits_loader,
+        shared_gate_up_hits_loader,
+        shared_hits_scale_loader,
+    )
+
+    torch.manual_seed(0)
+    layer, w_s = 1, 0.37
+    src = f"model.layers.{layer}.mlp.shared_mlp"
+    w = _expert_tensors(ckpt, layer)
+    ln_w = ckpt.get(f"model.layers.{layer}.post_attention_layernorm.weight")
+    x_raw = (torch.randn(tokens, H) * 2.0).to(torch.bfloat16)
+    normed = rmsnorm(x_raw, ln_w).to(torch.bfloat16)  # as HYV3MoE.forward (fp32 norm * ln_w -> bf16)
+    aff, idx = _route(ckpt, layer, normed)
+    aff[:, :L] = 0
+    for t in range(tokens):
+        for j in range(K):
+            if idx[t, j] < L:
+                idx[t, j] = L + j
+    idx[0, 0], aff[0, 0] = 0, 0.5
+    idx[1, 0], aff[1, 0] = 0, 0.3
+    idx[1, 1], aff[1, 2] = 2, 0.25
+
+    sm = _build_mlp(ckpt, src, 1536, 8)  # rank 0's decode shared slice, today's layout
+    shard, Ip = sm.intermediate_shard, sm.intermediate_size_per_rank
+    gu_ref = torch.stack([sm.gate_proj_weight.data, sm.up_proj_weight.data], dim=1).unsqueeze(0)
+    gu = shared_gate_up_hits_loader(shard, Ip, 0).transform(
+        [ckpt.slice(f"{src}.gate_proj.weight"), ckpt.slice(f"{src}.up_proj.weight")], 0)
+    dn = shared_down_hits_loader(shard, Ip, 0).transform([ckpt.slice(f"{src}.down_proj.weight")], 0)
+    gus = shared_hits_scale_loader(2).transform(
+        [ckpt.slice(f"{src}.gate_proj.weight_scale"), ckpt.slice(f"{src}.up_proj.weight_scale")], 0)
+    dns = shared_hits_scale_loader(1).transform([ckpt.slice(f"{src}.down_proj.weight_scale")], 0)
+    assert torch.equal(gu.view(torch.uint8), gu_ref.view(torch.uint8)), "gate/up loader != shared_mlp_decode bytes"
+    assert torch.equal(dn.view(torch.uint8), sm.down_proj_weight.data.unsqueeze(0).view(torch.uint8))
+    assert torch.allclose(gus.view(2), torch.stack([sm.gate_weight_scale[0, 0], sm.up_weight_scale[0, 0]]))
+    assert torch.allclose(dns.view(1), sm.down_weight_scale[0, 0].view(1))
+
+    class Fused(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            for k, v in w.items():
+                self.register_buffer(k, v)
+            for k, v in (("s_gu", gu), ("s_dn", dn), ("s_gus", gus), ("s_dns", dns)):
+                self.register_buffer(k, v)
+
+        def forward(self, x, aff, idx):
+            rank_id = torch.zeros((1, 1), dtype=torch.int32, device=x.device)
+            return hy_model.routed_experts_tkg_hits_shared(
+                x, aff, idx, rank_id, self.gate_up, self.down, self.gate_up_scale_tkg, self.down_scale_tkg,
+                self.s_gu, self.s_dn, self.s_gus, self.s_dns, w_s)
+
+    class Separate(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            for k, v in w.items():
+                self.register_buffer(k, v)
+            self.sm = sm
+            self.register_buffer("ln_w", ln_w)
+
+        def forward(self, x_raw, x, aff, idx):
+            rank_id = torch.zeros((1, 1), dtype=torch.int32, device=x.device)
