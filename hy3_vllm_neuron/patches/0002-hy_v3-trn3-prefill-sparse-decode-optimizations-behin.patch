+
+
+# <-- STATIC-MX (trn3): prefill routed experts on ``bwmm_shard_on_block_mx`` with
+# QuantizationType.STATIC_MX. Its fp8 is OCP e4m3fn (448), so the checkpoint
+# bytes and scales are used as-is (no halving). FP8 bytes are packed 4 at a
+# time along the contraction dim (fp8 carrier, last dim x4):
+#   gate_up [L, 128, 2, H/512, 4*I]: byte q of [e, p, j, t, i] = W_j[i, q*H/4 + t*128 + p]
+#   down    [L, p_I, nI, 4*H]:       byte q of [e, p, k, h]    = D[h, 512k + q*s_k/4 + p]
+_MX_Q = 4
+
+
+def _pack_mx_gate_up(gate: torch.Tensor, up: torch.Tensor) -> torch.Tensor:
+    """gate/up ``[I, H]`` fp8 -> fp8 carrier ``[128, 2, H/512, 4*I]``."""
+    I, H = gate.shape
+    n_h = H // (PMAX * _MX_Q)
+    out = []
+    for w in (gate, up):
+        u8 = w.view(torch.uint8).T.reshape(_MX_Q, n_h, PMAX, I).permute(2, 1, 3, 0)
+        out.append(u8.reshape(PMAX, n_h, I * _MX_Q))
+    return torch.stack(out, dim=1).contiguous().view(FP8_DTYPE)
+
+
+def _pack_mx_down(down: torch.Tensor) -> torch.Tensor:
+    """down ``[H, I]`` fp8 -> fp8 carrier ``[p_I, nI, 4*H]``."""
+    H, I = down.shape
+    n_i = -(-I // 512)
+    p_i = PMAX if I > 512 else I // _MX_Q
+    d = down.view(torch.uint8).T  # [I, H]
+    out = torch.zeros(p_i, n_i, H, _MX_Q, dtype=torch.uint8)
+    for k in range(n_i):
+        s = min(512, I - 512 * k)
+        tile = d[512 * k : 512 * k + s].reshape(_MX_Q, s // _MX_Q, H).permute(1, 2, 0)
+        out[: s // _MX_Q, k] = tile
+    return out.reshape(p_i, n_i, H * _MX_Q).contiguous().view(FP8_DTYPE)
+
+
+def expert_gate_up_mx_loader(num_experts: int) -> SafetensorsWeightLoader:
+    """``[gate_0..gate_{L-1}, up_0..up_{L-1}]`` -> ``[L, 128, 2, H/512, 4*I]`` (STATIC_MX)."""
+
+    def transform(slices, rank):
+        assert len(slices) == 2 * num_experts
+        return torch.stack(
+            [
+                _pack_mx_gate_up(slices[e][:, :], slices[num_experts + e][:, :])
+                for e in range(num_experts)
+            ]
+        ).contiguous()
+
+    return SafetensorsWeightLoader(transform=transform)
+
+
+def expert_down_mx_loader(num_experts: int) -> SafetensorsWeightLoader:
+    """``[down_0..down_{L-1}]`` -> ``[L, p_I, nI, 4*H]`` (STATIC_MX)."""
+
+    def transform(slices, rank):
+        assert len(slices) == num_experts
+        return torch.stack([_pack_mx_down(s[:, :]) for s in slices]).contiguous()
+
+    return SafetensorsWeightLoader(transform=transform)
+
+
+def expert_raw_scale_loader(
+    num_experts: int, num_groups: int, shape_fn, same_groups: bool = False
+) -> SafetensorsWeightLoader:
+    """Per-expert scalar scales (checkpoint values, no FP8 compensation) -> kernel layout.
+
+    ``slices`` is grouped by projection. ``same_groups`` asserts the groups are
+    equal per expert and keeps one (the fused gate/up input scale).
+    """
+
+    def transform(slices, rank):
+        assert len(slices) == num_experts * num_groups
+        vals = (
+            torch.stack([read_scalar_from_slice(s)[0] for s in slices])
+            .view(num_groups, num_experts)
+            .T
+        )  # [L, groups]
+        if same_groups:
+            assert torch.equal(vals, vals[:, :1].expand_as(vals)), (
+                f"fused gate/up experts must share one static input scale, got {vals}"
+            )
+            vals = vals[:, :1]
+        return shape_fn(vals).contiguous()
+
+    return SafetensorsWeightLoader(transform=transform)
+
+
+# <-- HY3_DECODE_FUSED_SHARED: the decode shared-expert slice in the routed hits kernel's layout,
+# same shard / zero-pad / halving as padded_mlp_loader, same scale compensation as the scalar loaders.
+def shared_gate_up_hits_loader(shard_size: int, padded_size: int, shard_rank: int) -> SafetensorsWeightLoader:
+    """``[gate [I, H], up [I, H]]`` -> ``[1, H, 2, padded]`` (rows ``shard_rank * shard_size`` + ``shard_size``)."""
+
+    def transform(slices, rank):
+        assert len(slices) == 2
+        parts = []
+        for s in slices:
+            w = _row_shard(s, shard_rank * shard_size, shard_size, 0).T  # [H, shard]
+            if shard_size < padded_size:
+                w = torch.cat([w, torch.zeros(w.shape[0], padded_size - shard_size, dtype=w.dtype)], dim=1)
+            parts.append(w)
+        return halve_fp8(torch.stack(parts, dim=1).unsqueeze(0).contiguous())  # [1, H, 2, padded]
+
+    return SafetensorsWeightLoader(transform=transform)
+
+
+def shared_down_hits_loader(shard_size: int, padded_size: int, shard_rank: int) -> SafetensorsWeightLoader:
+    """``down [H, I]`` -> ``[1, padded, H]``."""
+
+    def transform(slices, rank):
+        assert len(slices) == 1
+        w = _row_shard(slices[0], shard_rank * shard_size, shard_size, 1).T  # [shard, H]
+        if shard_size < padded_size:
+            w = torch.cat([w, torch.zeros(padded_size - shard_size, w.shape[1], dtype=w.dtype)], dim=0)
+        return halve_fp8(w.unsqueeze(0).contiguous())
+
+    return SafetensorsWeightLoader(transform=transform)
+
+
+def shared_hits_scale_loader(num_groups: int) -> SafetensorsWeightLoader:
+    """``[gate_scale, up_scale]`` -> ``[1, 2, 1]`` (num_groups 2) or ``[down_scale]`` -> ``[1, 1]``."""
+
+    def transform(slices, rank):
+        assert len(slices) == num_groups
+        vals = torch.stack([read_scalar_from_slice(s)[0] for s in slices]) * FP8_SCALE_COMPENSATION
+        return (vals.view(1, 2, 1) if num_groups == 2 else vals.view(1, 1)).contiguous()
+
+    return SafetensorsWeightLoader(transform=transform)
