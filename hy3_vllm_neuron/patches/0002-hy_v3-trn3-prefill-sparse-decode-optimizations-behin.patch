+# Derived from vllm_neuron.functional.attention.attention_decode (vllm-neuron 0.29).
+
+"""Decode attention block with the flash-attention early exit.
+
+``NF.attention_decode`` reads the whole decode context bucket
+(``S_ctx = max_blocks_per_seq * block_size``) for every sequence: the prior
+mask is precomputed, so the kernel cannot tell where the real context ends.
+The runner picks the bucket from the largest ``num_computed_tokens`` over the
+padded batch slots, so a short batch can run in a much larger bucket (a stale
+slot from an earlier long request is enough).
+
+This calls ``attention_block_tkg`` directly with ``pos_ids`` (the kernel builds
+the prior causal mask on-chip, ``iota < pos_id``) and ``max_context_len`` (the
+flash-attention loop stops after ``ceil(max_context_len / tile)`` tiles), so
+the K/V read follows the batch's real context. Non-DCP, block KV cache only.
+"""
+
+import nki
+import torch
+from libtorch_neuronx_lite.nki.nki_hop import wrap_nki
+from nkilib.core.utils.common_types import QuantizationType
+from nkilib.experimental.transformer.attention_block_tkg import (
+    attention_block_tkg as _nki_attention_block_tkg,
+)
+from vllm_neuron.utils.hardware_config import get_logical_nc_config
+
+
+@nki.jit
+def _attention_block_tkg_early_exit_kernel(
+    X,
+    X_hidden_dim_actual: int = None,
+    rmsnorm_X_enabled: bool = False,
+    rmsnorm_X_eps: float = None,
+    rmsnorm_X_gamma=None,
+    W_qkv=None,
+    quantization_type_qkv: QuantizationType = QuantizationType.NONE,
+    weight_dequant_scale_qkv=None,
+    input_dequant_scale_qkv=None,
+    rmsnorm_QK_pre_rope_enabled: bool = False,
+    rmsnorm_QK_pre_rope_eps: float = 1e-6,
+    rmsnorm_QK_pre_rope_W_Q=None,
+    rmsnorm_QK_pre_rope_W_K=None,
+    cos=None,
+    sin=None,
+    rope_contiguous_layout: bool = True,
+    active_blocks_table=None,
+    K_cache=None,
+    V_cache=None,
+    attention_mask=None,
+    softmax_scale: float = None,
+    pos_ids=None,
+    max_context_len=None,
+    kv_cache_update_idx=None,
+    k_scale=None,
+    v_scale=None,
+    W_out=None,
+    quantization_type_out: QuantizationType = QuantizationType.NONE,
+    weight_dequant_scale_out=None,
+    input_dequant_scale_out=None,
+):
+    return _nki_attention_block_tkg(
+        X=X,
+        X_hidden_dim_actual=X_hidden_dim_actual,
+        rmsnorm_X_enabled=rmsnorm_X_enabled,
+        rmsnorm_X_eps=rmsnorm_X_eps,
+        rmsnorm_X_gamma=rmsnorm_X_gamma,
+        W_qkv=W_qkv,
+        bias_qkv=None,
+        quantization_type_qkv=quantization_type_qkv,
+        weight_dequant_scale_qkv=weight_dequant_scale_qkv,
+        input_dequant_scale_qkv=input_dequant_scale_qkv,
+        rmsnorm_QK_pre_rope_enabled=rmsnorm_QK_pre_rope_enabled,
+        rmsnorm_QK_pre_rope_eps=rmsnorm_QK_pre_rope_eps,
+        rmsnorm_QK_pre_rope_W_Q=rmsnorm_QK_pre_rope_W_Q,
+        rmsnorm_QK_pre_rope_W_K=rmsnorm_QK_pre_rope_W_K,
+        cos=cos,
+        sin=sin,
+        rope_contiguous_layout=rope_contiguous_layout,
+        rmsnorm_QK_post_rope_enabled=False,
+        rmsnorm_QK_post_rope_eps=1e-6,
+        rmsnorm_QK_post_rope_W_Q=None,
+        rmsnorm_QK_post_rope_W_K=None,
+        K_cache_transposed=False,
+        active_blocks_table=active_blocks_table,
+        K_cache=K_cache,
+        V_cache=V_cache,
+        attention_mask=attention_mask,
+        sink=None,
+        softmax_scale=softmax_scale,
+        update_cache=True,
+        kv_cache_update_idx=kv_cache_update_idx,
+        k_scale=k_scale,
+        v_scale=v_scale,
+        fp8_packed=False,
+        W_out=W_out,
+        bias_out=None,
+        quantization_type_out=quantization_type_out,
+        weight_dequant_scale_out=weight_dequant_scale_out,
+        input_dequant_scale_out=input_dequant_scale_out,
+        transposed_out=False,
+        out_in_sb=False,
+        sbm=None,
+        skip_attention=False,
+        is_h_transposed_by_4=False,
+        KVDP=1,
+        KVDP_replica_group=None,
+        pos_ids=pos_ids,
+        swa_start_pos_ids=None,
+        S_ctx=None,
+        max_context_len=max_context_len,
+    )
+
+
+def attention_decode_early_exit(
+    X: torch.Tensor,
+    positions: torch.Tensor,
+    num_q_heads: int,
+    **kwargs,
+) -> torch.Tensor:
+    """``NF.attention_decode`` (update_cache=True, non-DCP) with the FA early exit.
+
+    ``positions`` is ``[B * S_tkg]`` (absolute position of each active token
+    = its prior-token count). The remaining keyword arguments are the
+    ``attention_block_tkg`` arguments Hy3 passes to ``NF.attention_decode``.
+    Returns the attention-block output ``[B, S_tkg, H]``.
+    """
+    B, S_tkg, _ = X.shape
+    pos_ids = positions.view(B, S_tkg).to(torch.float32)
+    # Active-only causal overlay [S_tkg, B, q_heads, S_tkg] (the kernel builds
+    # the prior part from pos_ids).
+    triu = torch.triu(torch.ones(S_tkg, S_tkg, dtype=torch.float32, device=X.device))
+    active_mask = triu[:, None, None, :].expand(S_tkg, B, num_q_heads, S_tkg).contiguous()
+    max_context_len = (positions.max() + 1).to(torch.int32).reshape(1)
+    out = wrap_nki(_attention_block_tkg_early_exit_kernel)[get_logical_nc_config()](
+        X,
+        attention_mask=active_mask,
+        pos_ids=pos_ids,
+        max_context_len=max_context_len,
+        **kwargs,
+    )
+    # The kernel returns (output, K, V); K/V are the in-place-updated caches.
+    return out[0]
