+def test_routed_experts_hits_decode_tp8(ckpt, tokens):
+    """HY3_DECODE_EXPERT_TP=8: rank 0 of the EP8 x TP8 decode copy (experts 0..23, I slice 0/8);
+    the hits kernels' partial must equal the exact I-slice contribution of those experts."""
+    torch.manual_seed(0)
+    layer, Ld, t = 1, 24, 8
+    I = 1536; Id = I // t
+    p = f"model.layers.{layer}.mlp.experts"
+
+    def slices(proj, suffix):
+        return [ckpt.slice(f"{p}.{e}.{proj}.{suffix}") for e in range(Ld)]
+
+    gu_s = slices("gate_proj", "weight_scale") + slices("up_proj", "weight_scale")
+    w = {
+        "gate_up": expert_gate_up_loader(Ld, Id, 0).transform(
+            slices("gate_proj", "weight") + slices("up_proj", "weight"), 0),
+        "down": expert_down_loader(Ld, Id, 0).transform(slices("down_proj", "weight"), 0),
+        "gu_s": expert_scale_loader(Ld, 2, lambda s: s.view(Ld, 2, 1)).transform(gu_s, 0),
+        "d_s": expert_scale_loader(Ld, 1, lambda s: s.view(Ld, 1)).transform(slices("down_proj", "weight_scale"), 0),
+    }
+    ln_w = ckpt.get(f"model.layers.{layer}.post_attention_layernorm.weight").float()
+    x = (torch.randn(tokens, H) * ln_w).to(torch.bfloat16)
+    aff, idx = _route(ckpt, layer, x)
+    # route some slots to rank 0's experts (0..23) so the hit path does work
+    for tkn in range(tokens):
+        idx[tkn, :3] = torch.tensor([2 + tkn, 11, 23 - tkn])
+        aff[tkn] = 0
+        aff[tkn, idx[tkn]] = torch.rand(K) + 0.1
+
+    class M(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            for k, v in w.items():
+                self.register_buffer(k, v)
+
+        def forward(self, x, aff, idx):
+            r = torch.zeros((1, 1), dtype=torch.int32, device=x.device)
+            fn = hy_model.routed_experts_tkg_hits if x.shape[0] == 1 else hy_model.routed_experts_tkg_hits_batch
+            return fn(x, aff, idx, r, self.gate_up, self.down, self.gu_s, self.d_s)
+
+    out = compile_and_run(M(), x, aff, idx.to(torch.int32))
+    ref = torch.zeros(tokens, H)
+    for e in range(Ld):
+        wg = dequant(ckpt.get(f"{p}.{e}.gate_proj.weight"), ckpt.scalar(f"{p}.{e}.gate_proj.weight_scale"))[:Id]
+        wu = dequant(ckpt.get(f"{p}.{e}.up_proj.weight"), ckpt.scalar(f"{p}.{e}.up_proj.weight_scale"))[:Id]
+        wd = dequant(ckpt.get(f"{p}.{e}.down_proj.weight"), ckpt.scalar(f"{p}.{e}.down_proj.weight_scale"))[:, :Id]
+        xf = x.float()
+        ref += (torch.nn.functional.silu(xf @ wg.T) * (xf @ wu.T)) @ wd.T * aff[:, e:e + 1]
+    err = rel_err(out, ref)
+    print(f"hits decode TP8 T={tokens}: rel_err={err:.3e}")
+    assert err < REL_TOL
