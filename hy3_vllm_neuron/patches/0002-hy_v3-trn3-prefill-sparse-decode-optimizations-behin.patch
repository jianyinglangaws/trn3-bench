+                        nbsd_row = (
+                            i_head * dims.B * dims.S + i_batch * dims.S + dims.S_shard_offset + s_tile_local_offset
+                        )
+                        nisa.dma_copy(
+                            dst=output_hbm.flatten_dims(start_dim=0, end_dim=2).slice(
