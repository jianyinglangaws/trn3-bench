index 0000000..26c1271
--- /dev/null
+++ b/contrib/models/hy_v3/test/module/io_stable_check.py
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One-core check of HY3_IO_STABLE (src/io_stable.py) on a torch.compile'd graph.
+
+Runs the same compiled function over many steps with CPU tensor + Python scalar
+inputs (the patched path), keeps some outputs and views alive across steps (the
+pool must not reuse them), and compares every result with a CPU reference.
+Also reports the per-launch host time and IO address stability.
+
+    HY3_IO_STABLE=2 python io_stable_check.py [--steps 200]
+"""
+
+import argparse
+import os
+import time
+
+import torch
+
+
+def f(x, idx, s, w):
+    y = (x @ w) * s
+    g = y.index_select(0, idx)
+    return y.sum(0), g, idx * 2 + 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--steps", type=int, default=200)
+    ap.add_argument("--sysprof", default="")
+    ap.add_argument("--async_depth", type=int, default=0)  # >0: enqueue this many steps before reading any output  # dir: host system profile of steps 100..150
+    a = ap.parse_args()
+    from hy_v3_neuron import io_stable
+    from vllm_neuron.envs import get_compile_backend_name
+
+    io_stable.apply()
+    dev = "neuron:0"
+    torch.manual_seed(0)
+    w = torch.randn(256, 128).to(dev)
+    wc = w.cpu()
+    fn = torch.compile(f, backend=get_compile_backend_name(), fullgraph=True)
+    if a.async_depth:
+        bad = 0
+        for rnd in range(a.steps // a.async_depth):
+            pend = []
+            for j in range(a.async_depth):
+                x = torch.randn(64, 256)
+                idx = torch.randint(0, 64, (16,), dtype=torch.int32)
+                out = fn(x.to(dev), idx.to(dev), 1.5, w)  # inputs dropped right after enqueue
+                pend.append((x, idx, out))
+            for x, idx, out in pend:
+                ry = (x @ wc) * 1.5
+                ok = (torch.allclose(out[0].cpu(), ry.sum(0), rtol=2e-2, atol=2e-1)
+                      and torch.allclose(out[1].cpu(), ry.index_select(0, idx.long()), rtol=2e-2, atol=2e-1)
+                      and torch.equal(out[2].cpu(), idx * 2 + 1))
+                bad += not ok
+        print(f"async depth {a.async_depth}: mismatches={bad} of {a.steps // a.async_depth * a.async_depth}, h2d {io_stable._H2D_STATS}")
+        print("PASS" if bad == 0 else "FAIL")
+        return
+    kept, bad, ptrs = [], 0, set()
+    t0 = None
+    for step in range(a.steps):
+        x = torch.randn(64, 256)
+        idx = torch.randint(0, 64, (16,), dtype=torch.int32)
+        s = 1.5
+        if step == 5:
+            t0 = time.perf_counter()
+        if a.sysprof and step == 100:
+            rt = torch.classes.neuron.Runtime()
+            rt.start_profiling(a.sysprof, ["system_profile"], None, None, a.sysprof + "/neffs")
+        if a.sysprof and step == 150:
+            rt.stop_profiling()
+        out = fn(x.to(dev), idx.to(dev), s, w)  # fresh device tensors every step, like the runner
+        o_sum, o_g, o_idx = (t.cpu() for t in out)
+        ptrs.add(tuple(t.data_ptr() for t in out))
+        ry = (x @ wc) * s
+        ref = (ry.sum(0), ry.index_select(0, idx.long()), idx * 2 + 1)
+        ok = (torch.allclose(o_sum, ref[0], rtol=2e-2, atol=2e-1) and torch.allclose(o_g, ref[1], rtol=2e-2, atol=2e-1)
+              and torch.equal(o_idx, ref[2]))
+        bad += not ok
+        if step % 10 == 0:  # hold device outputs + a view for a while: must never be overwritten
+            kept.append((step, out[1], out[1][:4].view(-1), ref[1].clone()))
+        if len(kept) > 6:
+            st, d, v, r = kept.pop(0)
+            if not (torch.allclose(d.cpu(), r, rtol=2e-2, atol=2e-1) and torch.allclose(v.cpu(), r[:4].reshape(-1), rtol=2e-2, atol=2e-1)):
+                print(f"held output of step {st} was overwritten")
+                bad += 1
+    dt = (time.perf_counter() - t0) / (a.steps - 5)
+    print(f"HY3_IO_STABLE={os.environ.get('HY3_IO_STABLE', '0')} steps={a.steps} mismatches={bad} "
+          f"distinct output address sets={len(ptrs)} per-step {dt * 1e3:.3f} ms")
+    print("PASS" if bad == 0 else "FAIL")
+
+
+if __name__ == "__main__":
+    main()
