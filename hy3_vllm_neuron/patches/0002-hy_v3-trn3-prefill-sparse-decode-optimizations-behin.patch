+++ b/contrib/models/hy_v3/src/kernels/ksum_update.py
@@ -0,0 +1,121 @@
+"""Hy3 sparse decode: fused K-summary update (HY3_SPARSE_KSUM_KERNEL).
+
+Replaces the torch tail of ``update_k_summary_decode`` (masked min / max over the step's S tokens,
+gather of the first group's old summary, merge, ``index_put_``), which the p28c16 profile showed as a
+GpSimd scatter (~35 us per layer, 2.8 ms per b16 step) plus ~0.8 ms of small Vector ops.
+
+One request per partition (B <= 128):
+  min_a / max_a = min / max over the tokens in the request's first group (others masked to +-EMPTY)
+  min_b / max_b = same for the tokens that crossed into the next group
+  old           = k_sum[key_a]                                   (indirect DMA gather)
+  new_a         = fresh ? (min_a, max_a) : (min(old_min, min_a), max(old_max, max_a))
+  new_b         = has_b ? (min_b, max_b) : new_a                (key_b == key_a then)
+  k_sum[key_a] = new_a; k_sum[key_b] = new_b                    (indirect DMA scatter)
+
+The merge is idempotent (re-applying it to an updated row gives the same row), so both LNC2 cores may
+run the whole kernel. Out-of-range keys (warm-up dummy tables) skip both the gather and the scatter
+(oob_mode.skip), like the kernel's KV-cache scatter. Bit-identical to the torch path: masking adds +-EMPTY to fp32 K, which rounds to
+exactly +-EMPTY; the blends multiply by exact 0 / 1 flags.
+"""
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+from nki.isa.constants import oob_mode
+
+EMPTY = 3.0e38
+
+
+@nki.jit
+def ksum_update_kernel(k_sum, k, excl_a, excl_b, fresh, has_b, key_a, key_b):
+    """k_sum: [blocks, 2, 1, D] (or [blocks, 2 * D]) bf16 summaries, updated in place.
+    k: [B, S * D] fp32 (token-major per request), excl_a / excl_b: [B, S] fp32 (1 = token not in
+    group a / b), fresh / has_b: [B, 1] fp32 flags, key_a / key_b: [B, 1] uint32 summary rows.
+    Returns k_sum.
+    """
+    B, SD = k.shape
+    S = excl_a.shape[1]
+    D = SD // S
+    D2 = 2 * D
+    ks_out = k_sum
+    if len(k_sum.shape) != 2:  # [blocks, 2, 1, D] -> [blocks, 2 * D]
+        k_sum = k_sum.reshape((k_sum.shape[0], D2))
+
+    k_sb = nl.ndarray((B, SD), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=k_sb, src=k)
+    ea = nl.ndarray((B, S), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=ea, src=excl_a)
+    eb = nl.ndarray((B, S), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=eb, src=excl_b)
+    fr = nl.ndarray((B, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=fr, src=fresh)
+    hb = nl.ndarray((B, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.dma_copy(dst=hb, src=has_b)
+    ia = nl.ndarray((B, 1), dtype=key_a.dtype, buffer=nl.sbuf)
+    nisa.dma_copy(dst=ia, src=key_a)
+    ib = nl.ndarray((B, 1), dtype=key_b.dtype, buffer=nl.sbuf)
+    nisa.dma_copy(dst=ib, src=key_b)
+
+    # Old summary of group a (gathered while the vector work below runs).
+    old_bf = nl.ndarray((B, D2), dtype=k_sum.dtype, buffer=nl.sbuf)
+    nisa.dma_copy(
+        dst=old_bf,
+        src=k_sum.ap(pattern=[[D2, B], [1, D2]], offset=0, vector_offset=ia, indirect_dim=0),
+        oob_mode=oob_mode.skip,
+    )
+
+    # Penalties: +EMPTY * excl for the min, -EMPTY * excl for the max.
+    pa = nl.ndarray((B, S), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=pa, data=ea, op0=nl.multiply, operand0=EMPTY)
+    pb = nl.ndarray((B, S), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=pb, data=eb, op0=nl.multiply, operand0=EMPTY)
+
+    # new rows (fp32): [:, :D] = min, [:, D:] = max
+    na = nl.ndarray((B, D2), dtype=nl.float32, buffer=nl.sbuf)
+    nb = nl.ndarray((B, D2), dtype=nl.float32, buffer=nl.sbuf)
+    tmp = nl.ndarray((B, D), dtype=nl.float32, buffer=nl.sbuf)
+    for s in range(S):
+        ks = k_sb[:, nl.ds(s * D, D)]
+        for dst, pen in ((na, pa), (nb, pb)):
+            # min half: k + pen ; max half: k - pen
+            if s == 0:
+                nisa.tensor_scalar(dst=dst[:, nl.ds(0, D)], data=ks, op0=nl.add, operand0=pen[:, s : s + 1])
+                nisa.tensor_scalar(dst=dst[:, nl.ds(D, D)], data=ks, op0=nl.subtract, operand0=pen[:, s : s + 1])
+            else:
+                nisa.tensor_scalar(dst=tmp, data=ks, op0=nl.add, operand0=pen[:, s : s + 1])
+                nisa.tensor_tensor(dst=dst[:, nl.ds(0, D)], data1=dst[:, nl.ds(0, D)], data2=tmp, op=nl.minimum)
+                nisa.tensor_scalar(dst=tmp, data=ks, op0=nl.subtract, operand0=pen[:, s : s + 1])
+                nisa.tensor_tensor(dst=dst[:, nl.ds(D, D)], data1=dst[:, nl.ds(D, D)], data2=tmp, op=nl.maximum)
+
+    # Merge group a with its old summary unless the step starts the group (fresh):
+    # old_min + fresh * EMPTY, old_max - fresh * EMPTY, then min / max.
+    old = nl.ndarray((B, D2), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=old, src=old_bf)
+    fpen = nl.ndarray((B, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=fpen, data=fr, op0=nl.multiply, operand0=EMPTY)
+    nisa.tensor_scalar(dst=old[:, nl.ds(0, D)], data=old[:, nl.ds(0, D)], op0=nl.add, operand0=fpen)
+    nisa.tensor_scalar(dst=old[:, nl.ds(D, D)], data=old[:, nl.ds(D, D)], op0=nl.subtract, operand0=fpen)
+    nisa.tensor_tensor(dst=na[:, nl.ds(0, D)], data1=na[:, nl.ds(0, D)], data2=old[:, nl.ds(0, D)], op=nl.minimum)
+    nisa.tensor_tensor(dst=na[:, nl.ds(D, D)], data1=na[:, nl.ds(D, D)], data2=old[:, nl.ds(D, D)], op=nl.maximum)
+
+    # new_b = has_b * new_b + (1 - has_b) * new_a  (exact for 0 / 1 flags, finite values)
+    nhb = nl.ndarray((B, 1), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=nhb, data=hb, op0=nl.multiply, operand0=-1.0, op1=nl.add, operand1=1.0)
+    t2 = nl.ndarray((B, D2), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_scalar(dst=nb, data=nb, op0=nl.multiply, operand0=hb)
+    nisa.tensor_scalar(dst=t2, data=na, op0=nl.multiply, operand0=nhb)
+    nisa.tensor_tensor(dst=nb, data1=nb, data2=t2, op=nl.add)
+
+    na_bf = nl.ndarray((B, D2), dtype=k_sum.dtype, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=na_bf, src=na)
+    nb_bf = nl.ndarray((B, D2), dtype=k_sum.dtype, buffer=nl.sbuf)
+    nisa.tensor_copy(dst=nb_bf, src=nb)
+    nisa.dma_copy(
+        dst=k_sum.ap(pattern=[[D2, B], [1, D2]], offset=0, vector_offset=ia, indirect_dim=0), src=na_bf,
+        oob_mode=oob_mode.skip,
+    )
+    nisa.dma_copy(
+        dst=k_sum.ap(pattern=[[D2, B], [1, D2]], offset=0, vector_offset=ib, indirect_dim=0), src=nb_bf,
+        oob_mode=oob_mode.skip,
+    )
+    return ks_out
