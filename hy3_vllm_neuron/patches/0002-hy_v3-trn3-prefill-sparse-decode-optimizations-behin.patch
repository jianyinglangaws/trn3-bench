+                    sum_recip_sb=_pp_sum_recip_sb,
+                    v_scale_sb=v_scale_sb,
+                    o_batch=_pp_o_batch,
+                    o_tp_sb=_pp_o_tp_sb,
+                    batch_id=b_idx + bs_offset,
+                    tp_out=tp_out,
+                    head_dim=head_dim,
+                    sb_p=sb_p,
+                    num_grps=num_grps,
+                    seqlen_q=seqlen_q,
+                    num_d_tiles=num_d_tiles,
+                    d_tile_size_par_dim=d_tile_size_par_dim,
+                    num_free=num_free_pp,
