diff --git a/contrib/models/hy_v3/src/prefix_align.py b/contrib/models/hy_v3/src/prefix_align.py
new file mode 100644
index 0000000..7cddbcc
--- /dev/null
+++ b/contrib/models/hy_v3/src/prefix_align.py
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Prefix-cache hits rounded down to a multiple of HY3_PREFIX_ALIGN tokens.
+
+The segmented prefill kernel over a coarse request-block view (HY3_PREFILL_ATTN_BLOCK=B, model.py
+_coarsen_request_blocks) is exact only when the prior length is a multiple of B. In this stack the
+prior is (prefix-cache hit) + whole prefill chunks, and hits are multiples of the cache block size
+(32). Trimming each hit to a multiple of B (dropping at most B/32 - 1 trailing blocks, i.e. <= B - 32
+recomputed tokens) keeps every prior B-aligned. Wraps KVCacheManager.get_computed_blocks in the
+scheduler process; a no-op when HY3_PREFIX_ALIGN is unset.
+"""
+
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+
+_ALIGN = int(os.environ.get("HY3_PREFIX_ALIGN", "0"))
+_applied = False
+
+
+def apply():
+    global _applied
+    if _applied or _ALIGN <= 0:
+        return
+    from vllm.v1.core.kv_cache_manager import KVCacheBlocks, KVCacheManager
+
+    orig = KVCacheManager.get_computed_blocks
+
+    def get_computed_blocks(self, request):
+        blocks, n, boundary = orig(self, request)
+        if n <= 0 or n % _ALIGN == 0:
+            return blocks, n, boundary
+        keep = n - n % _ALIGN
+        trimmed = []
+        for gi, group in enumerate(blocks.blocks):
+            bs = self.kv_cache_config.kv_cache_groups[gi].kv_cache_spec.block_size
+            assert _ALIGN % bs == 0, f"HY3_PREFIX_ALIGN={_ALIGN} must be a multiple of block_size {bs}"
+            trimmed.append(list(group)[: keep // bs])
+        return KVCacheBlocks(tuple(trimmed)), keep, boundary
+
+    KVCacheManager.get_computed_blocks = get_computed_blocks
+    _applied = True
+    logger.warning("hy3 prefix_align: prefix-cache hits rounded down to multiples of %d tokens", _ALIGN)
