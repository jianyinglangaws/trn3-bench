+                x, aff, idx, rank_id, self.gate_up, self.down, self.gate_up_scale_tkg, self.down_scale_tkg)
+            return r + self.sm(x_raw, self.ln_w, EPS, is_prefill=False) * w_s
+
+    idx32 = idx.to(torch.int32)
+    out_f = compile_and_run(Fused(), normed, aff, idx32)
