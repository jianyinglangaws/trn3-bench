+++ b/contrib/models/hy_v3/src/kernels/row_scatter.py
@@ -0,0 +1,39 @@
+"""Hy3: indirect-DMA row scatter (HY3_PREFILL_ROW_SCATTER).
+
+``dst[idx[r]] = rows[r]`` for flat row views (``dst`` [N, W], ``rows`` [R, W], ``idx`` [R, 1] uint32), in
+128-row tiles: one SBUF load + one indirect DMA write per tile. Out-of-range indices skip the write
+(oob_mode.skip), so padding rows can point past the end. Replaces the GpSimd ``index_put_`` the prefill
+uses for the packed-FP8 K cache (rows = token pairs [D, 2]) and V cache (rows = tokens [D]); the p30w
+profile showed that write at ~0.85 ms per layer in the 128-bucket (gang tail) prefill graph.
+Rows with equal indices: last write wins (callers only duplicate padding, which targets the null block).
+"""
+
+import nki
+import nki.isa as nisa
+import nki.language as nl
+from nki.isa.constants import oob_mode
+
+
+@nki.jit
+def row_scatter_kernel(dst, rows, idx):
+    """dst: any-rank cache viewed as [N, W] (W = rows.shape[1]); rows: [R, W]; idx: [R, 1] uint32.
+    Updated in place; returns dst."""
+    R, W = rows.shape
+    out = dst
+    n = 1
+    for d in dst.shape:
+        n = n * d
+    flat = dst.reshape((n // W, W))
+    P = 128
+    for t in range(0, R, P):
+        p = min(P, R - t)
+        r_sb = nl.ndarray((p, W), dtype=rows.dtype, buffer=nl.sbuf)
+        nisa.dma_copy(dst=r_sb, src=rows[nl.ds(t, p), :])
+        i_sb = nl.ndarray((p, 1), dtype=idx.dtype, buffer=nl.sbuf)
+        nisa.dma_copy(dst=i_sb, src=idx[nl.ds(t, p), :])
+        nisa.dma_copy(
+            dst=flat.ap(pattern=[[W, p], [1, W]], offset=0, vector_offset=i_sb, indirect_dim=0),
+            src=r_sb,
+            oob_mode=oob_mode.skip,
+        )
+    return out
