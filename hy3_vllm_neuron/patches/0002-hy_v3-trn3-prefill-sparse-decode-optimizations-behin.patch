@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One-core timing: segmented prefill attention, unsplit vs 4-piece LNC-balanced split.
+
+One Q head (Hy3 at TP=64), BF16 cache (the request-block copy the FP8 path
+attends over), T query tokens after `prior` cached tokens.
+
+    python bench_prefill_attn.py [T prior ...pairs]   (default: 8192 0 8192 8192)
+"""
+
+import os
+import sys
+import time
+
+import torch
+
+os.environ.setdefault("TORCH_CACHING_PRECOMPILE", "0")
+os.environ.setdefault("NEURON_RT_ROOT_COMM_ID", "127.0.0.1:62182")
+from hy_v3_neuron import model as hy_model  # noqa: E402
+from vllm_neuron.envs import get_compile_backend_name  # noqa: E402
+import vllm_neuron.functional as NF  # noqa: E402
+
+DEV, D, BLOCK, N = "neuron:0", 128, 32, 20
+SEG = int(os.environ.get("BENCH_SEG", "2048"))
+ONLY_UNSPLIT = os.environ.get("BENCH_ONLY_UNSPLIT", "0") == "1"
+SAVE = os.environ.get("BENCH_SAVE")  # path: save unsplit outputs for cross-version comparison
+
+
+BIG = int(os.environ.get("BENCH_BIG_BLOCK", "0"))  # >0: view the contiguous request copy as blocks of this size
+
+
+class Unsplit(torch.nn.Module):
+    def forward(self, q, k, v, bt, prior):
+        bs = BLOCK
+        if BIG:
+            r = BIG // BLOCK
+            nb = k.shape[0] // r
+            k = k[: nb * r].reshape(nb, 1, BIG, D)
+            v = v[: nb * r].reshape(nb, 1, BIG, D)
+            bt = torch.arange(nb, dtype=bt.dtype, device=bt.device).view(1, nb)
+            bs = BIG
+        return NF.segmented_attention(
+            q, k_cache=k, v_cache=v, block_tables=bt, prior_tokens=prior,
+            block_size=bs, kv_segment_size=SEG, scale=D ** -0.5, tp_q=True, tp_out=True,
+        )
+
+
+class Split(torch.nn.Module):
+    def forward(self, q, k, v, bt, prior):
+        return hy_model.segmented_attention_balanced(q, k, v, bt, prior, BLOCK, SEG, D ** -0.5)
+
+
+def bench(m, args):
+    f = torch.compile(m, backend=get_compile_backend_name(), fullgraph=True)
+    with torch.no_grad():
+        out = f(*args).cpu()
+        prof = os.environ.get("BENCH_PROF")  # dir: device profile of 3 calls (after warm-up)
+        if prof:
+            rt = torch.classes.neuron.Runtime()
+            rt.start_profiling(prof, ["device_profile"], None, None, prof + "/neffs")
+            for _ in range(3):
+                f(*args).cpu()
+            rt.stop_profiling()
+        t0 = time.perf_counter()
+        for _ in range(N):
+            o = f(*args)
+            o.cpu()  # per-call sync: torch.neuron.synchronize does not drain the queue
+        o.cpu()
+    return (time.perf_counter() - t0) / N * 1e3, out.float()
+
+
+def main():
+    a = [int(x) for x in sys.argv[1:]] or [8192, 0, 8192, 8192]
+    for T, prior in zip(a[::2], a[1::2]):
+        L = T + prior
+        nb = L // BLOCK
+        torch.manual_seed(0)
+        k = (torch.randn(nb + 1, 1, BLOCK, D) * 2).to(torch.bfloat16)
+        v = torch.randn(nb + 1, 1, BLOCK, D).to(torch.bfloat16)
+        if os.environ.get("BENCH_CONTIG", "0") == "1":
+            k, v = k[:nb], v[:nb]
+            bt = torch.arange(nb).view(1, nb).to(torch.int32)
+        else:
+            bt = (torch.randperm(nb) + 1).view(1, nb).to(torch.int32)
+        q = (torch.randn(1, T, D) * 2).to(torch.bfloat16)
+        pr = torch.tensor([[prior]], dtype=torch.int32)
+        args = tuple(t.to(DEV) for t in (q, k, v, bt, pr))
+        tu, ou = bench(Unsplit(), args)
+        if ONLY_UNSPLIT:
+            import nkilib
+            print(f"T={T} prior={prior} seg={SEG}: unsplit {tu:.3f} ms  (nkilib {nkilib.__file__})")
+            if SAVE:
+                torch.save(ou, f"{SAVE}_{T}_{prior}.pt")
+            continue
+        ts, os_ = bench(Split(), args)
+        d = ((os_ - ou).norm() / ou.norm()).item()
+        print(f"T={T} prior={prior}: unsplit {tu:.3f} ms  split {ts:.3f} ms  ({tu / ts:.2f}x)  rel diff {d:.2e}")
+
+
+if __name__ == "__main__":
+    main()
