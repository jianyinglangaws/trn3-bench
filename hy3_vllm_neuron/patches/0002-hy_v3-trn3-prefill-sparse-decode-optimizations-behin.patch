+"""
+QKV kernel.
+
+"""
+
+# Standard Library
+from typing import Optional
+
+# Neuron Kernel Interface
+import nki
+import nki.language as nl
+
+from nkilib.core.utils.allocator import SbufManager
+
+# NKI Library
+from nkilib.core.utils.common_types import (
+    DtypeMode,
+    NormType,
+    QKNormConfig,
+    QKVOutputLayout,
+    QKVWeightLayout,
+    QuantizationType,
