+            batch_h_i = (batch_id % num_q_heads) * num_kv_head // num_q_heads
+            b_i_list.append(batch_b_i)
+            h_i_list.append(batch_h_i)
+            if tp_q:
+                nisa.dma_copy(
+                    dst=q_internal[b_idx, :, :],
+                    src=q.ap(
