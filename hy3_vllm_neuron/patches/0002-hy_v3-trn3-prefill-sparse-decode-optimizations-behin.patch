@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: Apache-2.0
+"""One-core timing: decode routed experts, STATIC all-expert moe_tkg vs STATIC_MX.
+
+Rank-0 layer-1 experts of the real checkpoint (E_L=3, I=1536), T tokens.
+Each variant runs N calls back to back inside one compiled graph call loop.
+
+    HY3_CKPT=<ckpt> python bench_moe_tkg.py [T ...]
+"""
+
+import os
+import sys
+import time
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+os.environ.setdefault("TORCH_CACHING_PRECOMPILE", "0")
+from conftest import Checkpoint  # noqa: E402
+from hy_v3_neuron import model as hy_model  # noqa: E402
+from test_mlp_moe import H, K, _expert_tensors, _expert_tensors_mx, _route  # noqa: E402
+from vllm_neuron.envs import get_compile_backend_name  # noqa: E402
+
+DEV = "neuron:0"
+N = 50
+
+
+class Static(torch.nn.Module):
+    def __init__(self, w):
+        super().__init__()
+        for k, v in w.items():
+            self.register_buffer(k, v)
+
+    def forward(self, x, aff, idx):
+        r = torch.zeros((1, 1), dtype=torch.int32, device=x.device)
+        return hy_model.routed_experts_tkg(
+            x, aff, idx, r, self.gate_up, self.down, self.gate_up_scale_tkg, self.down_scale_tkg
+        )
+
+
+class MX(torch.nn.Module):
+    def __init__(self, w):
+        super().__init__()
+        for k, v in w.items():
+            self.register_buffer(k, v)
+
+    def forward(self, x, aff, idx):
+        r = torch.zeros((1, 1), dtype=torch.int32, device=x.device)
+        return hy_model.routed_experts_tkg_mx(
+            x, aff, idx, r, self.gate_up, self.down, self.gate_up_scale, self.down_scale,
+            self.gate_up_in, self.down_in,
+        )
+
+
+def bench(m, args):
+    f = torch.compile(m.to(DEV), backend=get_compile_backend_name(), fullgraph=True)
+    with torch.no_grad():
+        f(*args).cpu()
+        t0 = time.perf_counter()
+        for _ in range(N):
+            o = f(*args)
+            o.cpu()  # per-call sync: torch.neuron.synchronize does not drain the queue
+        o.cpu()
+    return (time.perf_counter() - t0) / N * 1e3
+
+
+def main():
+    ck = Checkpoint(os.environ["HY3_CKPT"])
+    layer = 1
+    ws, wm = _expert_tensors(ck, layer), _expert_tensors_mx(ck, layer)
+    ln_w = ck.get(f"model.layers.{layer}.post_attention_layernorm.weight").float()
+    for T in [int(t) for t in sys.argv[1:]] or [16]:
+        x = (torch.randn(T, H) * ln_w).to(torch.bfloat16)
+        aff, idx = _route(ck, layer, x)
+        args = (x.to(DEV), aff.to(DEV), idx.to(torch.int32).to(DEV))
+        ts, tm = bench(Static(ws), args), bench(MX(wm), args)
+        print(f"T={T}: STATIC {ts:.3f} ms/call  STATIC_MX {tm:.3f} ms/call  ({ts / tm:.2f}x)")
+
+
+if __name__ == "__main__":
+    main()
