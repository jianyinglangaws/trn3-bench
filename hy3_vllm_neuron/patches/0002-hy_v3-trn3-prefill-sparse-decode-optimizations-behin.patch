+# SPDX-License-Identifier: Apache-2.0
+"""STATIC_MX prefill experts (nkilib ``bwmm_shard_on_block_mx``) without the final shard reduction.
+
+The stock kernel accumulates each LNC shard's blocks into its own dense ``[T, H]`` half of a
+``[2, T, H]`` buffer and ends with a dense ``out[0] += out[1]`` over all T rows (DMA compute,
+~0.33 ms at T=16384), after which the caller's ``narrow`` of ``out[0]`` is materialized as a
+128 MB copy before the reduce-scatter (~0.38 ms). Both are fixed per-layer costs on every rank.
+This entry skips the in-kernel reduction; the caller adds ``out[0, :T] + out[1, :T]`` in the
+graph, which writes the reduce-scatter input directly.
+
+Separate entry name on purpose: the compile cache keys NKI kernels by entry-function name.
+"""
+
+from typing import Any, Optional
+
+import nki
+import nki.language as nl
+
+import nkilib.core.moe.moe_cte.bwmm_shard_on_block_mx as _bwmm_mod
+from nkilib.core.moe.moe_cte.moe_cte import ActFnType, ExpertAffinityScaleMode, SkipMode
+from nkilib.core.utils.common_types import QuantizationType
+
+
+def _no_reduce(*args, **kwargs):
+    return None
+
+
+@nki.jit(mode="trace")
+def hy3_moe_cte_mx_noreduce(
+    hidden_states: nl.NkiTensor,
+    expert_affinities_masked: nl.NkiTensor,
+    gate_up_proj_weight: nl.NkiTensor,
+    down_proj_weight: nl.NkiTensor,
+    token_position_to_id: nl.NkiTensor,
+    block_to_expert: nl.NkiTensor,
+    block_size: int,
+    n_static_blocks: int = -1,
+    n_dynamic_blocks: int = 55,
+    top_k: int = 1,
+    ep_degree: int = 1,
+    conditions: Optional[nl.NkiTensor] = None,
+    activation_function: ActFnType = ActFnType.SiLU,
+    skip_token: bool = False,
+    skip_weight: bool = False,
+    compute_dtype: Any = nl.bfloat16,
+    is_tensor_update_accumulating: bool = True,
+    expert_affinities_scaling_mode: ExpertAffinityScaleMode = ExpertAffinityScaleMode.POST_SCALE,
+    gate_up_proj_scale: Optional[nl.NkiTensor] = None,
+    down_proj_scale: Optional[nl.NkiTensor] = None,
+    gate_up_in_scale: Optional[nl.NkiTensor] = None,
+    down_in_scale: Optional[nl.NkiTensor] = None,
+):
+    """Same arguments as vllm_neuron's ``_torch_compatible_moe_cte_static_mx_kernel``;
+    returns the unreduced ``[2, T, H]`` per-shard partial outputs."""
+    saved = _bwmm_mod.reduce_outputs
+    _bwmm_mod.reduce_outputs = _no_reduce  # trace-time patch, restored below
+    try:
+        return _bwmm_mod.bwmm_shard_on_block_mx(
+            hidden_states=hidden_states,
+            expert_affinities_masked=expert_affinities_masked,
+            gate_up_proj_weight=gate_up_proj_weight,
+            down_proj_weight=down_proj_weight,
+            token_position_to_id=token_position_to_id,
+            block_to_expert=block_to_expert,
+            conditions=conditions,
+            gate_and_up_proj_bias=None,
+            down_proj_bias=None,
+            gate_up_proj_scale=gate_up_proj_scale,
+            down_proj_scale=down_proj_scale,
+            block_size=block_size,
+            n_static_blocks=n_static_blocks,
+            n_dynamic_blocks=n_dynamic_blocks,
+            top_k=top_k,
+            ep_degree=ep_degree,
+            gate_up_activations_T=None,
+            down_activations=None,
+            activation_function=activation_function,
+            skip_dma=SkipMode(skip_token=skip_token, skip_weight=skip_weight),
+            compute_dtype=compute_dtype,
+            is_tensor_update_accumulating=is_tensor_update_accumulating,
+            expert_affinities_scaling_mode=expert_affinities_scaling_mode,
+            gate_clamp_upper_limit=None,
+            gate_clamp_lower_limit=None,
+            up_clamp_upper_limit=None,
+            up_clamp_lower_limit=None,
+            use_packed_scales=False,
+            quantization_type=QuantizationType.STATIC_MX,
+            gate_up_in_scale=gate_up_in_scale,
+            down_in_scale=down_in_scale,
+        )
+    finally:
+        _bwmm_mod.reduce_outputs = saved
