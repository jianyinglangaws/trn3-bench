+# SPDX-License-Identifier: Apache-2.0
+"""Stable device addresses for compiled-graph IO (HY3_IO_STABLE).
+
+libtorch-neuronx-lite's dynamo ``Executor`` gives every NEFF launch fresh IO
+buffers: CPU inputs and Python scalars are copied with ``.to(device)`` into a
+new device tensor, and every non-aliased output is a new ``torch.empty``. The
+runtime's IO DMA-ring cache (``NEURON_RT_IO_RING_CACHE_SIZE``) is keyed on the
+IO buffers, so it never hits and every launch rebuilds its DMA rings in
+``kbl_exec_pre`` (~34 ``nrt_dma_mem_alloc`` per launch, 6-20 ms of host time per
+launch on Hy3 decode). With MTP the decode loop is host-bound, so that time sits
+on the device critical path (the per-step execution barrier waits for the
+slowest rank's launch).
+
+This patch keeps, per executor, ``K`` rotating slots of persistent device
+buffers:
+
+- CPU tensor / Python scalar inputs are written into the slot's input buffer
+  with ``copy_`` (no allocation) instead of ``.to(device)``;
+- small device inputs (<= ``HY3_IO_STABLE_MAXB`` bytes) whose address moved
+  between launches (the runner creates them fresh every step) are copied
+  device-to-device into the slot's stable buffer;
+- non-aliased outputs reuse the slot's previous output buffer when nothing
+  outside the pool references it (neither the Python object nor its storage,
+  so live views block reuse); otherwise a new buffer is allocated.
+
+The slot advances after every launch, so a buffer is reused only ``K`` launches
+later on the same executor. Each NeuronCore runs its queue in order, so a reused
+output is written only after earlier queued executions that read it. The input
+``copy_`` is only unsafe if an execution ``K`` launches older than the current
+one has not started yet (the Hy3 runner keeps 1-2 launches in flight).
+
+Modes: ``HY3_IO_STABLE=0`` off (default), ``1`` stats only (no behaviour change),
+``2`` stabilize + stats. ``HY3_IO_STABLE_K`` slots (default 4). Stats (rank of
+``NEURON_RT_VISIBLE_CORES`` 0 only) are logged every ``HY3_IO_STABLE_LOG``
+launches per executor.
+"""
+
+import logging
+import os
+import sys
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+_MODE = int(os.environ.get("HY3_IO_STABLE", "0"))
+_K = int(os.environ.get("HY3_IO_STABLE_K", "4"))
+_LOG_EVERY = int(os.environ.get("HY3_IO_STABLE_LOG", "500"))
+# device inputs up to this many bytes whose address moves between launches are copied into a
+# stable buffer (device-to-device copy_); larger ones (weights, KV caches) are left alone.
+_MAX_STAGE_BYTES = int(os.environ.get("HY3_IO_STABLE_MAXB", str(1 << 20)))
+_H2D = os.environ.get("HY3_IO_STABLE_H2D", "0") == "1"
+_PTRS = os.environ.get("HY3_IO_STABLE_PTRS", "0") == "1"  # log distinct input addresses per index
+# HY3_IO_STABLE_H2D=2: trace only -- log the call sites of small CPU->neuron Tensor.to (rank 0), no pooling.
+_H2D_TRACE = os.environ.get("HY3_IO_STABLE_H2D", "0") == "2"
+# HY3_IO_STABLE_H2D=3: per-call-site strict round-robin of K_SITE device buffers for small CPU->neuron
+# Tensor.to in the vLLM-neuron runner / MTP proposer (the per-step decode inputs found with mode 2).
+# A buffer is rewritten only K_SITE calls of the same site later (the runner keeps 1-2 launches in flight);
+# unlike mode 1 it never hands back a buffer the previous launch may still read.
+_H2D_SITE = os.environ.get("HY3_IO_STABLE_H2D", "0") == "3"
+_K_SITE = int(os.environ.get("HY3_IO_STABLE_K_SITE", "8"))
+_SITE_FILES = ("neuron_model_runner.py", "eagle.py")
+_H2D_MAXB = int(os.environ.get("HY3_IO_STABLE_H2D_MAXB", str(64 << 10)))
+_H2D_POOL_CAP = 16
+_applied = False
+
+
+def _storage_uses(t: torch.Tensor) -> int:
+    return torch._C._storage_Use_Count(t.untyped_storage()._cdata)
+
+
+def _state(ex):
+    st = ex.__dict__.get("_hy3_io")
+    if st is None:
+        st = {
+            "slot": 0, "in": {}, "out": {}, "calls": 0, "cpu_in": 0, "scalar_in": 0,
+            "dev_in_moved": 0, "dev_in": 0, "out_new": 0, "out_reused": 0, "last_ptr": {},
+        }
+        ex.__dict__["_hy3_io"] = st
+    return st
+
+
+def _log_rank() -> bool:
+    return os.environ.get("NEURON_RT_VISIBLE_CORES", "0") == "0"
+
+
+def apply():
+    """Patch the IO path of the active backend (idempotent; no-op when HY3_IO_STABLE=0).
+
+    VLLM_NEURON_BACKEND=neuron_native runs graphs through
+    ``libtorch_neuronx_lite.compile.native_backend._lite_execute`` (C++
+    ``torch.classes.neuron.Executor``); the dynamo ``Executor`` is the other path.
+    """
+    global _applied
+    if _applied or _MODE == 0:
+        return
+    _patch_native()
+    _patch_dynamo()
+    if _H2D:
+        _patch_h2d()
+    if _H2D_TRACE:
+        _patch_h2d_trace()
+    if _H2D_SITE:
+        _patch_h2d_site()
+    _applied = True
+    logger.warning("hy3_io_stable: patched IO path (mode=%d, K=%d, maxb=%d)", _MODE, _K, _MAX_STAGE_BYTES)
+
+
+def _stage_inputs(st, inputs, stabilize):
+    """Per-step device inputs (small, address moved before) -> slot's stable buffer."""
+    slot = st["slot"]
+    out = []
+    for i, inp in enumerate(inputs):
+        if isinstance(inp, torch.Tensor) and inp.device.type != "cpu":
+            st["dev_in"] += 1
+            p = inp.data_ptr()
+            if st["last_ptr"].get(i, p) != p:
+                st["dev_in_moved"] += 1
+                st.setdefault("moving", set()).add(i)
+            st["last_ptr"][i] = p
+            if _PTRS:
+                ps = st.setdefault("ptrs", {}).setdefault(i, set())
+                if len(ps) < 256:
+                    ps.add(p)
+                st.setdefault("pshape", {})[i] = (tuple(inp.shape), str(inp.dtype), inp.is_contiguous(),
+                                                  inp.storage_offset())
+            if (
+                stabilize
+                and i in st.get("moving", ())
+                and inp.is_contiguous()
+                and inp.numel() * inp.element_size() <= _MAX_STAGE_BYTES
+            ):
+                key = (i, slot)
+                buf = st["in"].get(key)
+                if buf is None or buf.shape != inp.shape or buf.dtype != inp.dtype:
+                    buf = torch.empty(inp.shape, dtype=inp.dtype, device=inp.device)
+                    st["in"][key] = buf
+                    st["in_new"] = st.get("in_new", 0) + 1
+                buf.copy_(inp)
+                st["dev_staged"] = st.get("dev_staged", 0) + 1
+                out.append(buf)
+                continue
+        out.append(inp)
+    return out
+
+
+def _pooled_empty(st, i, shape, dtype, device):
+    key = (i, st["slot"])
+    buf = st["out"].get(key)
+    # refs when only the pool holds it: dict + local + getrefcount arg = 3;
+    # storage: the tensor + the temporary storage object = 2.
+    if (
+        buf is not None
+        and tuple(buf.shape) == tuple(shape)
+        and buf.dtype == dtype
+        and sys.getrefcount(buf) <= 3
+        and _storage_uses(buf) <= 2
+    ):
+        st["out_reused"] += 1
+        return buf
+    buf = torch.empty(tuple(shape), dtype=dtype, device=device)
+    st["out"][key] = buf
+    st["out_new"] += 1
+    return buf
+
+
+def _tick(st, name):
+    st["slot"] = (st["slot"] + 1) % _K
+    st["calls"] += 1
+    if _LOG_EVERY and st["calls"] % _LOG_EVERY == 0 and _log_rank():
+        logger.warning(
+            "[hy3_io_stable mode=%d K=%d] %s calls=%d per-call: dev_in=%.2f dev_in_moved=%.2f "
+            "dev_staged=%.2f in_new=%.3f out_new=%.3f out_reused=%.2f | h2d %s",
+            _MODE, _K, name[:40], st["calls"],
+            *(st.get(k, 0) / st["calls"] for k in
+              ("dev_in", "dev_in_moved", "dev_staged", "in_new", "out_new", "out_reused")),
+            {**_H2D_STATS, **_SITE_STATS, "sites": len(_SITE_RINGS)},
+        )
+        if _PTRS:
+            many = {i: (len(v), st["pshape"][i]) for i, v in st.get("ptrs", {}).items() if len(v) > 1}
+            logger.warning("[hy3_io_stable ptrs] %s inputs with >1 distinct address: %s", name[:40], many)
+
+
+_NATIVE_STATE: dict = {}
+
+
+def _patch_native():
+    from libtorch_neuronx_lite.compile import native_backend as nb
+
+    orig = nb._lite_execute
+    stabilize = _MODE >= 2
+
+    def _lite_execute(artifact, inputs):
+        if nb._is_native_precompile():
+            return orig(artifact, inputs)
+        st = _NATIVE_STATE.get(artifact.cache_key)
+        if st is None:
+            st = _NATIVE_STATE[artifact.cache_key] = _state(types_ns())
+        original_inputs = tuple(inputs)
+        inputs = original_inputs
+        device = inputs[0].device if inputs else torch.device("privateuseone", 0)
+        pass_mutations = getattr(artifact, "pass_mutations", None)
+        if pass_mutations:
+            from libtorch_neuronx_lite._compiler.neuron_dynamo_backend.fx.io_mutation import (
+                apply_input_mutations,
+            )
+
+            inputs = tuple(apply_input_mutations(list(inputs), pass_mutations, str(device)))
+        if len(inputs) != len(artifact.io_spec.inputs):
+            raise RuntimeError(
+                f"[{nb.BACKEND_NAME}] Expected {len(artifact.io_spec.inputs)} inputs "
+                f"after mutations, got {len(inputs)}"
+            )
+        ex = nb._executor_for(artifact)
+        alias_out_to_in = {a.output_index: a.input_index for a in artifact.io_spec.aliases}
+        # stage only inputs that are not aliased to an output (in-place KV writes must hit the caller's buffer)
+        aliased_in = set(alias_out_to_in.values())
+        staged = _stage_inputs(st, inputs, stabilize)
+        exec_inputs = [inputs[j] if j in aliased_in else staged[j] for j in range(len(inputs))]
+        outputs = []
+        for i, spec in enumerate(artifact.io_spec.outputs):
+            if i in alias_out_to_in:
+                outputs.append(exec_inputs[alias_out_to_in[i]])
+            elif stabilize:
+                outputs.append(_pooled_empty(st, i, spec.shape, spec.dtype, device))
+            else:
+                outputs.append(torch.empty(tuple(spec.shape), dtype=spec.dtype, device=device))
+        execute_context = nb.get_execute_context()
+        metadata = nb._EXECUTE_METADATA.get(artifact.cache_key) if execute_context is not None else None
+        if metadata is not None and execute_context.pre_execute_hook is not None:
+            execute_context.pre_execute_hook(tuple(exec_inputs), metadata)
+        ex.execute(list(exec_inputs), outputs)
+        if metadata is not None and execute_context.execute_hook is not None:
+            execute_context.execute_hook(tuple(exec_inputs), outputs, metadata)
+        if pass_mutations:
+            from libtorch_neuronx_lite._compiler.neuron_dynamo_backend.fx.io_mutation import (
+                apply_output_mutations,
+            )
+
+            outputs = apply_output_mutations(outputs, pass_mutations, str(device), list(original_inputs))
+        else:
+            aliased = {a.output_index for a in artifact.io_spec.aliases}
+            outputs = [t for i, t in enumerate(outputs) if i not in aliased]
+        _tick(st, artifact.cache_key)
+        return tuple(outputs)
+
+    nb._lite_execute = _lite_execute
+
+
+class types_ns:  # holder object for _state()
+    pass
+
+
+def _patch_dynamo():
+    from libtorch_neuronx_lite._compiler.neuron_dynamo_backend import executor as exmod
+    Ex = exmod.Executor
+    orig_prepare = Ex._prepare_inputs
+    orig_alloc = Ex._allocate_output
+    orig_call = Ex.__call__
+    stabilize = _MODE >= 2
+
+    def _prepare_inputs(self, inputs, device_id):
+        st = _state(self)
+        slot = st["slot"]
+        staged = []
+        for i, inp in enumerate(inputs):
+            src = None
+            if not isinstance(inp, torch.Tensor):
+                if isinstance(inp, (bool, int, float)):
+                    src = torch.tensor(inp)
+                    st["scalar_in"] += 1
+            elif inp.device.type == "cpu":
+                if inp.dtype not in (torch.float64, torch.complex128):
+                    src = inp if inp.is_contiguous() else inp.contiguous()
+                st["cpu_in"] += 1
+            else:
+                st["dev_in"] += 1
+                p = inp.data_ptr()
+                if st["last_ptr"].get(i, p) != p:
+                    st["dev_in_moved"] += 1
+                    st.setdefault("moving", set()).add(i)
+                st["last_ptr"][i] = p
+                if (
+                    i in st.get("moving", ())
+                    and inp.is_contiguous()
+                    and inp.numel() * inp.element_size() <= _MAX_STAGE_BYTES
+                ):
+                    src = inp
+                    st["dev_staged"] = st.get("dev_staged", 0) + 1
+            if stabilize and src is not None:
+                key = (i, slot)
+                buf = st["in"].get(key)
+                if buf is None or buf.shape != src.shape or buf.dtype != src.dtype:
+                    buf = torch.empty(src.shape, dtype=src.dtype, device=f"neuron:{device_id}")
+                    st["in_new"] = st.get("in_new", 0) + 1
+                    st["in"][key] = buf
+                buf.copy_(src)
+                staged.append(buf)
+            else:
+                staged.append(inp)
+        yield from orig_prepare(self, staged, device_id)
+
+    def _allocate_output(self, i, out, neuron_inputs, device_str):
+        if not stabilize or (self.alias_buffer_map and i in self.alias_buffer_map):
+            return orig_alloc(self, i, out, neuron_inputs, device_str)
+        st = _state(self)
+        key = (i, st["slot"])
+        buf = st["out"].get(key)
+        # refs when only the pool holds it: dict + local + getrefcount arg = 3;
+        # storage: the tensor + the temporary storage object = 2.
+        if (
+            buf is not None
+            and buf.shape == out.shape
+            and buf.dtype == out.dtype
+            and sys.getrefcount(buf) <= 3
+            and _storage_uses(buf) <= 2
+        ):
+            st["out_reused"] += 1
+            return buf
+        buf = torch.empty(out.shape, dtype=out.dtype, device=device_str)
+        st["out"][key] = buf
+        st["out_new"] += 1
+        return buf
+
+    def __call__(self, *inputs):
+        res = orig_call(self, *inputs)
+        st = _state(self)
+        st["slot"] = (st["slot"] + 1) % _K
+        st["calls"] += 1
+        if _LOG_EVERY and st["calls"] % _LOG_EVERY == 0 and _log_rank():
+            logger.warning(
+                "[hy3_io_stable mode=%d K=%d] %s calls=%d per-call: cpu_in=%.2f scalar_in=%.2f "
+                "dev_in=%.2f dev_in_moved=%.2f dev_staged=%.2f in_new=%.2f out_new=%.2f out_reused=%.2f",
+                _MODE, _K, self.graph_name, st["calls"],
+                *(st.get(k, 0) / st["calls"] for k in
+                  ("cpu_in", "scalar_in", "dev_in", "dev_in_moved", "dev_staged", "in_new", "out_new",
+                   "out_reused")),
+            )
+        return res
+
+    Ex._prepare_inputs = _prepare_inputs
+    Ex._allocate_output = _allocate_output
+    Ex.__call__ = __call__
+
+
+# ---------------------------------------------------------------------------
+# HY3_IO_STABLE_H2D=1: small host->device moves (the runner rebuilds ~10 tiny per-step input
+# tensors with ``.to(self.device)`` every step) reuse pooled device buffers, filled by a host write
+# (``copy_`` from CPU: no allocation, no extra launch), so the NEFF IO addresses repeat and the
+# runtime's IO DMA-ring cache can hit. A pooled buffer is handed out only when nothing references it:
+# no Python refs and storage use count at its baseline (a queued launch holding the tensor shows up
+# in the storage count). Compiled regions and anything but plain device / dtype moves fall back.
+_H2D_STATS = {"pooled": 0, "new": 0, "fallback_full": 0}
+_H2D_POOLS: dict = {}
+
+
+def _target(args, kwargs):
+    """(device, dtype) for the simple Tensor.to forms, else None."""
+    if kwargs.keys() - {"device", "dtype", "non_blocking"}:
+        return None
+    dev, dtype = kwargs.get("device"), kwargs.get("dtype")
+    rest = list(args)
+    if rest and isinstance(rest[0], (str, torch.device)):
+        dev = rest.pop(0)
+    if rest and isinstance(rest[0], torch.dtype):
+        dtype = rest.pop(0)
+    if rest and isinstance(rest[0], bool):  # non_blocking positional
+        rest.pop(0)
+    if rest or dev is None:
+        return None
+    dev = torch.device(dev)
+    if dev.type not in ("neuron", "privateuseone"):
+        return None
+    return dev, dtype
+
+
+def _patch_h2d():
+    orig_to = torch.Tensor.to
+
+    def to(self, *args, **kwargs):
+        if self.device.type == "cpu" and not torch.compiler.is_compiling():
+            tgt = _target(args, kwargs)
+            if tgt is not None:
+                dev, dtype = tgt
+                src = self if dtype is None or dtype == self.dtype else orig_to(self, dtype)
+                if src.numel() * src.element_size() <= _H2D_MAXB and src.numel() > 0:
+                    if dev.index is None:
+                        dev = torch.device(dev.type, torch.neuron.current_device())
+                    key = (tuple(src.shape), src.dtype, str(dev))
+                    pool = _H2D_POOLS.setdefault(key, [])
+                    for buf in pool:
+                        # refs: list + loop var + getrefcount arg = 3; storage: tensor + temp = 2
+                        if sys.getrefcount(buf) <= 3 and _storage_uses(buf) <= 2:
+                            buf.copy_(src if src.is_contiguous() else src.contiguous())
+                            _H2D_STATS["pooled"] += 1
+                            return buf
+                    out = orig_to(src, dev)
+                    if len(pool) < _H2D_POOL_CAP:
+                        pool.append(out)
+                        _H2D_STATS["new"] += 1
+                    else:
+                        _H2D_STATS["fallback_full"] += 1
+                    return out
+        return orig_to(self, *args, **kwargs)
+
+    torch.Tensor.to = to
+
+
+_TRACE_SITES: dict = {}
+
+
+def _patch_h2d_trace():
+    import traceback
+
+    orig_to = torch.Tensor.to
+
+    def to(self, *args, **kwargs):
+        if self.device.type == "cpu" and not torch.compiler.is_compiling() and _log_rank():
+            tgt = _target(args, kwargs)
+            if tgt is not None and 0 < self.numel() * self.element_size() <= _H2D_MAXB:
+                st = traceback.extract_stack(limit=6)[:-1]
+                key = tuple((f.filename.rsplit("/", 1)[-1], f.lineno) for f in st)
+                n = _TRACE_SITES.get(key, 0) + 1
+                _TRACE_SITES[key] = n
+                if n in (1, 1000):
+                    logger.warning("[hy3_h2d_trace] n=%d shape=%s dtype=%s site=%s", n, tuple(self.shape), self.dtype,
+                                   " <- ".join(f"{f}:{l}" for f, l in reversed(key)))
+        return orig_to(self, *args, **kwargs)
+
+    torch.Tensor.to = to
+
+
+_SITE_RINGS: dict = {}
+_SITE_STATS = {"site_copies": 0, "site_new": 0}
+
+
+def _patch_h2d_site():
+    orig_to = torch.Tensor.to
+
+    def to(self, *args, **kwargs):
+        if self.device.type == "cpu" and not torch.compiler.is_compiling():
+            f = sys._getframe(1)
+            fn = f.f_code.co_filename
+            if fn.endswith(_SITE_FILES):
+                tgt = _target(args, kwargs)
+                if tgt is not None:
+                    dev, dtype = tgt
+                    src = self if dtype is None or dtype == self.dtype else orig_to(self, dtype)
+                    if 0 < src.numel() * src.element_size() <= _H2D_MAXB:
+                        if dev.index is None:
+                            dev = torch.device(dev.type, torch.neuron.current_device())
+                        key = (fn, f.f_lineno, tuple(src.shape), src.dtype, str(dev))
+                        ring = _SITE_RINGS.get(key)
+                        if ring is None:
+                            ring = _SITE_RINGS[key] = [[], 0]
+                        bufs, i = ring
+                        if len(bufs) < _K_SITE:
+                            out = orig_to(src, dev)
+                            bufs.append(out)
+                            _SITE_STATS["site_new"] += 1
+                        else:
+                            out = bufs[i]
+                            out.copy_(src if src.is_contiguous() else src.contiguous())
+                            _SITE_STATS["site_copies"] += 1
+                        ring[1] = (i + 1) % _K_SITE
+                        return out
+        return orig_to(self, *args, **kwargs)
+
+    torch.Tensor.to = to
