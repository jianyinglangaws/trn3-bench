+        dst=src_sb[0:s_tile_sz, nl.ds(d_head + d_head_half, num_d_half)],
+        data1=src_sb[0:s_tile_sz, 0:num_d_half],
+        data2=sin_sb[0:s_tile_sz, 0:num_d_half],
+        op=nl.multiply,
