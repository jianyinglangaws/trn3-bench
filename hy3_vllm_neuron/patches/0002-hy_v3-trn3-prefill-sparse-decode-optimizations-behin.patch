index 0000000..2a97d6d
--- /dev/null
+++ b/contrib/models/hy_v3/test/module/kvdp_check.py
@@ -0,0 +1,226 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Multi-rank check: KVDP decode attention vs the standard decode path.
+
+Runs ``kvdp`` worker processes (one NeuronCore each). Worker r is TP rank r of
+the TP=64 deployment (Q head r, the KV head shared by ranks 0..7), built from
+the real checkpoint (layer 0) through the model's weight loaders. Every worker
+gets the same FP8 KV cache (replicated KV head) and the same decode batch, and
+runs ``HYV3Attention.forward_decode`` twice from identical caches:
+
+- standard path (``HY3_DECODE_KVDP_FORK`` off, ``NF.attention_decode``);
+- KVDP path (``kernels/attention_decode_kvdp.py``, in-kernel Q / output exchange
+  over the ``kvdp`` ranks).
+
+Checks per rank: output (O-projection partial) close to the standard path and
+the whole cache after the step byte-identical (every rank must write all B new
+tokens). Also times both paths (per call, back to back, includes collectives).
+
+    HY3_CKPT=<ckpt> python kvdp_check.py [--kvdp 8] [--B 16] [--nblk 256] [--packed 0|1]
+"""
+
+import argparse
+import os
+import sys
+import time
+import types
+from functools import partial
+
+import torch
+
+FP8 = torch.float8_e4m3fn
+FP8_MAX = 448.0
+TP, D, BLOCK, LAYER = 64, 128, 32, 0
+A = f"model.layers.{LAYER}.self_attn"
+QK, QV = 24.0, 900.0  # quantizing scales (layer-0 K ~ +-15, V ~ +-0.4)
+
+
+def _ckpt():
+    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+    from conftest import Checkpoint
+
+    return Checkpoint(os.environ["HY3_CKPT"])
+
+
+class _Group(types.SimpleNamespace):
+    def all_reduce(self, x):
+        return x  # the check compares per-rank O-proj partials
+
+    def reduce_scatter(self, x, dim=0):
+        return x
+
+    def all_gather(self, x, dim=0):
+        return x
+
+
+class _Decode(torch.nn.Module):
+    def __init__(self, attn):
+        super().__init__()
+        self.attn = attn
+
+    def forward(self, x, positions, cos, sin, slot_mapping, block_table, ln_w):
+        meta = {
+            "slot_mapping": slot_mapping,
+            "block_size": BLOCK,
+            "block_table_tensor": block_table,
+            "max_blocks_per_seq": block_table.shape[1],
+        }
+        return self.attn.forward_decode(
+            x, positions, (cos, sin), {self.attn.layer_name: meta}, ln_w, None
+        )
+
+
+class _Worker:
+    """Per-rank callable returned by model_load."""
+
+    def __init__(self, kvdp, packed):
+        from hy_v3_neuron import model as hy_model
+        from hy_v3_neuron.config import HYV3Config
+        from vllm.distributed.parallel_state import get_tp_group
+        from vllm_neuron.envs import get_compile_backend_name
+        from vllm_neuron.utils.weight_loader import get_weight_loader
+
+        self.hy = hy_model
+        self.rank = get_tp_group().rank_in_group
+        self.dev = "neuron:0"
+        self.packed = packed
+        self.kvdp = kvdp
+        rank_t = torch.tensor([self.rank], dtype=torch.int32, device=self.dev)
+        grp = _Group(world_size=TP, rank_in_group=self.rank, rank_in_group_tensor=rank_t)
+        hy_model.get_tp_group = lambda: grp
+        hy_model.get_dcp_group = lambda: _Group(world_size=1, rank_in_group=0)
+        cfg = HYV3Config()
+        a = hy_model.HYV3Attention(cfg, LAYER)
+        ck = _ckpt()
+        keys = {
+            "qkv_proj_weight": [f"{A}.{n}_proj.weight" for n in "qkv"],
+            "qkv_weight_scale": [f"{A}.{n}_proj.weight_scale" for n in "qkv"],
+            "qkv_input_scale": [f"{A}.{n}_proj.input_scale" for n in "qkv"],
+            "o_proj_weight": [f"{A}.o_proj.weight"],
+            "o_weight_scale": [f"{A}.o_proj.weight_scale"],
+            "o_input_scale": [f"{A}.o_proj.input_scale"],
+        }
+        with torch.no_grad():
+            for name, srcs in keys.items():
+                p = getattr(a, name)
+                p.data = get_weight_loader(p).transform([ck.slice(k) for k in srcs], self.rank)
+            a.q_norm.weight.data = ck.get(f"{A}.q_norm.weight").to(a.dtype)
+            a.k_norm.weight.data = ck.get(f"{A}.k_norm.weight").to(a.dtype)
+        self.ln_w = ck.get(f"model.layers.{LAYER}.input_layernorm.weight").to(a.dtype).to(self.dev)
+        a.requires_grad_(False)
+        a.kvdp_world = kvdp  # replica groups over the test's ranks
+        self.attn = a.to(self.dev)
+        self.attn.set_kv_scales(QK, QV, self.dev)
+        self.cfg = cfg
+        if os.environ.get("KVDP_CHECK_BAD_RANK") == "1":
+            # negative control: every rank claims the next rank's batch shard
+            bad = torch.tensor([(self.rank + 1) % kvdp], dtype=torch.int32, device=self.dev)
+            self.attn._kvdp_rank = lambda g: bad
+        backend = get_compile_backend_name()
+        self.std = torch.compile(_Decode(self.attn), backend=backend, fullgraph=True)
+        self.kv = torch.compile(_Decode(self.attn), backend=backend, fullgraph=True)
+
+    def _bind(self, k_u8, v_u8):
+        from hy_v3_neuron.fp8_kv_layout import swizzle_packed_k
+
+        k = swizzle_packed_k(k_u8) if self.packed else k_u8
+        self.attn.k_cache = k.contiguous().view(FP8).to(self.dev)
+        self.attn.v_cache = v_u8.contiguous().view(FP8).to(self.dev)
+        self.attn.fp8_packed = self.packed
+
+    def _caches(self):
+        from hy_v3_neuron.fp8_kv_layout import unswizzle_packed_k
+
+        k = self.attn.k_cache.cpu().view(torch.uint8)
+        if k.dim() == 5:
+            k = unswizzle_packed_k(k)
+        return k, self.attn.v_cache.cpu().view(torch.uint8)
+
+    def _run(self, fn, flag, args, iters):
+        self.hy._DECODE_KVDP_FORK = flag
+        with torch.no_grad():
+            out = fn(*args).cpu()
+            caches = self._caches()
+            t0 = time.perf_counter()
+            for _ in range(iters):
+                o = fn(*args)
+                o.cpu()
+            dt = (time.perf_counter() - t0) / iters
+        return out, caches, dt
+
+    def __call__(self, x, positions, cos, sin, slots, bt, k_u8, v_u8, iters):
+        dev = self.dev
+        args = (
+            x.to(dev), positions.to(dev), cos.to(dev), sin.to(dev),
+            slots.to(dev), bt.to(dev), self.ln_w,
+        )
+        iters = int(iters.item())
+        k_u8, v_u8 = k_u8.cpu().contiguous(), v_u8.cpu().contiguous()
+        self._bind(k_u8, v_u8)
+        o_std, c_std, t_std = self._run(self.std, 0, args, iters)
+        self._bind(k_u8, v_u8)
+        o_kv, c_kv, t_kv = self._run(self.kv, self.kvdp, args, iters)
+        return o_std, o_kv, c_std[0], c_kv[0], c_std[1], c_kv[1], torch.tensor([t_std, t_kv])
+
+
+def model_load(kvdp, packed):
+    return _Worker(kvdp, packed)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--kvdp", type=int, default=8)
+    ap.add_argument("--B", type=int, default=16)
+    ap.add_argument("--nblk", type=int, default=256)  # blocks per seq: 256 x 32 = 8192 bucket
+    ap.add_argument("--packed", type=int, default=1)
+    ap.add_argument("--iters", type=int, default=20)
+    ap.add_argument("--a2a", type=int, default=1)
+    ap.add_argument("--bad_rank", type=int, default=0)  # negative control: wrong KVDP rank
+    a = ap.parse_args()
+    os.environ["HY3_DECODE_KVDP_A2A"] = str(a.a2a)
+    os.environ["KVDP_CHECK_BAD_RANK"] = str(a.bad_rank)
+    os.environ.setdefault("NEURON_RT_ROOT_COMM_ID", "127.0.0.1:62182")
+    os.environ.setdefault("TORCH_CACHING_PRECOMPILE", "0")
+    from hy_v3_neuron import model as hy_model
+    from hy_v3_neuron.config import HYV3Config
+    from vllm_neuron.utils.executor import MPExecutor
+
+    B, nblk = a.B, a.nblk
+    S_ctx = nblk * BLOCK
+    g = torch.Generator().manual_seed(0)
+    lens = torch.randint(S_ctx // 8, S_ctx - 1, (B,), generator=g)
+    lens[0] = S_ctx - 2  # one near the bucket end
+    perm = torch.randperm(B * nblk, generator=g) + 1  # block 0 = null block
+    bt = perm.view(B, nblk).to(torch.int32)
+    num_blocks = B * nblk + 1
+    # Replicated KV head: random FP8 codes of plausible K (N(0,4)) / V (N(0,0.1)).
+    k = (torch.randn(num_blocks, 1, BLOCK, D, generator=g) * 4 * QK).clamp(-FP8_MAX, FP8_MAX)
+    v = (torch.randn(num_blocks, 1, BLOCK, D, generator=g) * 0.1 * QV).clamp(-FP8_MAX, FP8_MAX)
+    k_u8, v_u8 = k.to(FP8).view(torch.uint8), v.to(FP8).view(torch.uint8)
+    x = torch.randn(B, 4096, generator=g).to(torch.bfloat16)
+    positions = lens.clone()
+    cos, sin = hy_model.HYV3RotaryEmbedding(HYV3Config())(positions, "cpu", torch.bfloat16)
+    slots = torch.stack([bt[b, lens[b] // BLOCK].long() * BLOCK + lens[b] % BLOCK for b in range(B)])
+
+    ex = MPExecutor(world_size=a.kvdp, model_load=partial(model_load, a.kvdp, bool(a.packed)))
+    ins = (x, positions, cos, sin, slots, bt, k_u8, v_u8, torch.tensor([a.iters]))
+    ex.dispatch_per_rank([ins] * a.kvdp)
+    res = ex.collect(timeout=3600)
+    ok = True
+    for r, (o_std, o_kv, k_std, k_kv, v_std, v_kv, t) in enumerate(res):
+        o_std, o_kv = o_std.float(), o_kv.float()
+        rel = ((o_kv - o_std).norm() / o_std.norm()).item()
+        k_eq = torch.equal(k_std, k_kv)
+        v_eq = torch.equal(v_std, v_kv)
+        nk = (k_std != k_kv).sum().item()
+        nv = (v_std != v_kv).sum().item()
+        # the step must have written every sequence's new token (vs the initial cache)
+        wrote = (k_std != k_u8.view(k_std.shape) if k_std.shape == k_u8.shape else torch.ones(1)).any().item()
+        print(f"rank {r}: out rel diff {rel:.3e}  K cache equal {k_eq} ({nk} bytes differ)  "
+              f"V cache equal {v_eq} ({nv})  std {t[0]*1e3:.3f} ms  kvdp {t[1]*1e3:.3f} ms  wrote={wrote}")
+        ok &= rel < 2e-2 and k_eq and v_eq
+    print("PASS" if ok else "FAIL")
+    ex.shutdown()
+
+
+if __name__ == "__main__":
+    main()
