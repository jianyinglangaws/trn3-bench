+# HARDWARE CONSTANTS
+NUM_HW_PSUM_BANKS = 8
+MAX_STREAM_SHUFFLE_PARTITIONS = 32
+NUM_MX_WEIGHT_BUFFERS = 2
+MX_NEUTRAL_SCALE = 127  # MX scale exponent bias: 2^(127-127) = 2^0 = 1.0 (no scaling)
+NUM_QKV_SEGMENTS = 3  # Q, K, V
